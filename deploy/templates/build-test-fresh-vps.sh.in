#!/usr/bin/env bash
# Builds the cUSDT DAR (v@@VERSION@@) and runs the Daml Script unit tests on a FRESH VPS (no repo checkout needed): installs JDK + dpm if missing,
# writes the sources, downloads the vendored Splice API DARs and verifies their sha256, builds, tests. No network traffic on any ledger.
#   Save as a file, then:  bash build-test-fresh-vps.sh
set -euo pipefail
export PATH="$HOME/.dpm/bin:$PATH"
if ! command -v java >/dev/null || ! java -version 2>&1 | grep -qE 'version "(1[7-9]|[2-9][0-9])'; then apt-get update -y && apt-get install -y openjdk-17-jdk-headless curl; fi
command -v dpm >/dev/null || curl -fsSL https://get.digitalasset.com/install/install.sh | sh
export PATH="$HOME/.dpm/bin:$PATH"
(cd / && dpm install @@SDK@@) >/dev/null

W=$HOME/cusdt-build; C=$W/cusdt-token; T=$W/cusdt-token-test
mkdir -p $C/daml $C/dars $T/daml
cat > $C/daml.yaml <<'EOF_YAML'
@@EMBED daml/cusdt-token/daml.yaml@@
EOF_YAML
cat > $C/daml/CusdtToken.daml <<'EOF_DAML'
@@EMBED daml/cusdt-token/daml/CusdtToken.daml@@
EOF_DAML
cat > $T/daml.yaml <<'EOF_TYAML'
@@EMBED daml/cusdt-token-test/daml.yaml@@
EOF_TYAML
cat > $T/daml/CusdtTokenTest.daml <<'EOF_TDAML'
@@EMBED daml/cusdt-token-test/daml/CusdtTokenTest.daml@@
EOF_TDAML

echo "== vendored Splice API DARs (sha256 verified) =="
cd $C/dars
while read -r sum name; do
  [ -s "$name" ] || curl -fsSL -o "$name" "https://raw.githubusercontent.com/hyperledger-labs/splice/main/daml/dars/$name"
  echo "$sum *$name" | sha256sum -c - || { echo "CHECKSUM MISMATCH for $name, aborting"; exit 1; }
done <<'EOF_SUMS'
e2607ca3a1d735a82d3066b78132aa8f94b1886c99a5f14148742d252c7220a2 splice-api-token-allocation-instruction-v1-1.0.0.dar
c3f3b447142577ea4fa7d912ca11cd6821de7588e324e8877425932a02fccaa1 splice-api-token-allocation-v1-1.0.0.dar
ef75f8eb41a65810221784fdb78bb9dfac7cb22245aba14fa7cb7f69c34e0175 splice-api-token-holding-v1-1.0.0.dar
455eb160cb5abd4ae9918a6fbb9dad471f721adda39f0e5c76feef08d05637fc splice-api-token-metadata-v1-1.0.0.dar
e4c73aa7ae73fb2fc330b938ffb99f568792321640ba4b9472902aa8d742c994 splice-api-token-transfer-instruction-v1-1.0.0.dar
a18e85c4841a278bce000df8329c3f0e2fee3b30b55dd6a31492d10a72b4f9c1 splice-api-token-burn-mint-v1-1.0.0.dar
EOF_SUMS

echo "== build cusdt-token =="
cd $C && dpm install package && dpm build
DAR=$C/.daml/dist/cusdt-token-@@VERSION@@.dar; ls -la $DAR; sha256sum $DAR
echo "== build + run tests =="
cd $T && dpm install package && dpm build && dpm test 2>&1 | grep -E "^daml/|rror|failed|Failed" | sed -E 's/, [0-9]+ active contracts, [0-9]+ transactions//'
