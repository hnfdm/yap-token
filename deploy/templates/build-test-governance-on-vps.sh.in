#!/usr/bin/env bash
# Builds the yap-governance package (governed actions for a multi-owner admin) and runs its Daml Script tests.
# Needs ~/cusdt-build/yap-token/.daml/dist/yap-token-@@VERSION@@.dar from a previous build-test-fresh-vps.sh run.
#   Save as a file, then:  bash build-test-governance-on-vps.sh
set -euo pipefail
export PATH="$HOME/.dpm/bin:$PATH"
W=$HOME/cusdt-build; C=$W/yap-token; G=$W/yap-governance; GT=$W/yap-governance-test
[ -f $C/.daml/dist/yap-token-@@VERSION@@.dar ] || { echo "run build-test-fresh-vps.sh first (yap-token-@@VERSION@@.dar missing)"; exit 1; }
mkdir -p $G/daml $G/dars $GT/daml
cat > $G/daml.yaml <<'EOF_GY'
@@EMBED daml/yap-governance/daml.yaml@@
EOF_GY
cat > $G/daml/YapGovernance.daml <<'EOF_GD'
@@EMBED daml/yap-governance/daml/YapGovernance.daml@@
EOF_GD
cat > $GT/daml.yaml <<'EOF_GTY'
@@EMBED daml/yap-governance-test/daml.yaml@@
EOF_GTY
cat > $GT/daml/YapGovernanceTest.daml <<'EOF_GTD'
@@EMBED daml/yap-governance-test/daml/YapGovernanceTest.daml@@
EOF_GTD
echo "== governance-action-v1 DAR (sha256 verified) =="
cd $G/dars
[ -s governance-action-v1-0.1.0.dar ] || curl -fsSL -o governance-action-v1-0.1.0.dar https://raw.githubusercontent.com/DLC-link/decentralization-manager/main/releases/v1/governance-action-v1-0.1.0.dar
echo "4fc7912df4a0aeea3cfcc6ba07c880192a5fa88f7c75ed04b922602461b1e485 *governance-action-v1-0.1.0.dar" | sha256sum -c - || { echo "CHECKSUM MISMATCH, aborting"; exit 1; }
echo "== build yap-governance =="
cd $G && dpm install package && dpm build
DAR=$G/.daml/dist/yap-governance-0.3.0.dar; ls -la $DAR; sha256sum $DAR
echo "== build + run tests =="
cd $GT && dpm install package && dpm build && dpm test 2>&1 | grep -E "^daml/|rror|failed|Failed" | sed -E 's/, [0-9]+ active contracts, [0-9]+ transactions//'
