#!/usr/bin/env bash
# Builds the YAP test package on the testnet VPS and runs the Daml Script unit tests (no network, no traffic).
# Needs the DAR from update-on-vps.sh (it is rebuilt here if missing).   Save as a file, then:  bash test-on-vps.sh
set -euo pipefail
export PATH="$HOME/.dpm/bin:$PATH"
C=$HOME/yap-token/daml/yap-token
T=$HOME/yap-token/daml/yap-token-test
DAR=$C/.daml/dist/yap-token-@@VERSION@@.dar
[ -s "$DAR" ] || { echo "== building $DAR first =="; (cd $C && dpm install package && dpm build); }
ls -la "$DAR"
mkdir -p $T/daml
cat > $T/daml.yaml <<'EOF_YAML'
@@EMBED daml/yap-token-test/daml.yaml@@
EOF_YAML
cat > $T/daml/YapTokenTest.daml <<'EOF_DAML'
@@EMBED daml/yap-token-test/daml/YapTokenTest.daml@@
EOF_DAML
cd $T
echo "== build tests =="
dpm install package
dpm build
echo "== run tests =="
dpm test
