-- Unit tests for the YAP contracts (Daml Script, run with `dpm test`). No network, no traffic.
-- They cover what is awkward on a live testnet: time (expiry), exact authorisation, lock rules, delegation.
module YapTokenTest where

import Daml.Script
import DA.Time
import DA.Date
import DA.Map qualified as Map
import DA.TextMap qualified as TextMap
import YapToken
import Splice.Api.Token.AllocationInstructionV1 qualified as AI
import Splice.Api.Token.AllocationV1 qualified as A
import Splice.Api.Token.AllocationV2 qualified as A2
import Splice.Api.Token.AllocationInstructionV2 qualified as AI2
import Splice.Api.Token.BurnMintV1 qualified as BM
import Splice.Api.Token.HoldingV1 qualified as H
import Splice.Api.Token.HoldingV2 qualified as H2
import Splice.Api.Token.MetadataV1 qualified as M
import Splice.Api.Token.TransferInstructionV1 qualified as TI
import Splice.Api.Token.TransferInstructionV2 qualified as TI2

-- ---------------------------------------------------------------------------------------------------------
-- fixtures

data World = World with
  admin : Party
  alice : Party
  bob   : Party
  carol : Party
  tf    : ContractId YapTransferFactory
  af    : ContractId YapAllocationFactory
  tfD   : Disclosure
  afD   : Disclosure

noExtra : M.ExtraArgs
noExtra = M.ExtraArgs with
  context = M.ChoiceContext with values = TextMap.empty
  meta = M.emptyMetadata

setup : Script World
setup = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  carol <- allocateParty "carol"
  setTime (time (date 2026 Oct 12) 9 0 0)
  tf <- submit admin do createCmd YapTransferFactory with admin
  af <- submit admin do createCmd YapAllocationFactory with admin
  Some tfD <- queryDisclosure admin tf
  Some afD <- queryDisclosure admin af
  pure World with ..

mint : World -> Party -> Decimal -> Script (ContractId YapHolding)
mint w owner amount = submit w.admin do
  createCmd YapHolding with admin = w.admin, owner, amount, lock = None

-- (cid, contract) of the UNLOCKED holdings of a party / of everything (the admin is signatory of all)
freeOf : World -> Party -> Script [(ContractId YapHolding, YapHolding)]
freeOf w p = do
  hs <- query @YapHolding w.admin
  pure [ (c, h) | (c, h) <- hs, h.owner == p, h.lock == None ]

lockedOf : World -> Party -> Script [(ContractId YapHolding, YapHolding)]
lockedOf w p = do
  hs <- query @YapHolding w.admin
  pure [ (c, h) | (c, h) <- hs, h.owner == p, h.lock /= None ]

balance : World -> Party -> Script Decimal
balance w p = do
  hs <- freeOf w p
  pure (sum [ h.amount | (_, h) <- hs ])

supplyAll : World -> Script Decimal
supplyAll w = do
  hs <- query @YapHolding w.admin
  is <- query @YapTransferInstruction w.admin
  pure (sum [ h.amount | (_, h) <- hs ] + sum [ i.transfer.amount | (_, i) <- is ])

-- assert that a Script Decimal equals an expected value
expectBalance : Script Decimal -> Decimal -> Text -> Script ()
expectBalance s expected msg = do
  v <- s
  assertMsg (msg <> " (expected " <> show expected <> ", got " <> show v <> ")") (v == expected)

-- the fully parameterised form is used by the "must fail" tests that vary exactly one field
transferCmdFull : World -> Time -> Party -> Party -> Decimal -> [ContractId YapHolding] -> Party -> Party -> RelTime -> RelTime -> M.ExtraArgs -> Commands TI.TransferInstructionResult
transferCmdFull w now s r a ins expAdmin instAdmin reqOff execOff extra =
  exerciseCmd (toInterfaceContractId @TI.TransferFactory w.tf) TI.TransferFactory_Transfer with
    expectedAdmin = expAdmin
    transfer = TI.Transfer with
      sender = s
      receiver = r
      amount = a
      instrumentId = yapInstrumentId instAdmin
      requestedAt = addRelTime now reqOff
      executeBefore = addRelTime now execOff
      inputHoldingCids = map toInterfaceContractId ins
      meta = M.emptyMetadata
    extraArgs = extra

transferCmd : World -> Time -> Party -> Party -> Decimal -> [ContractId YapHolding] -> Commands TI.TransferInstructionResult
transferCmd w now s r a ins = transferCmdFull w now s r a ins w.admin w.admin (seconds (-30)) (hours 1) noExtra

sendOffer : World -> Party -> Party -> Decimal -> [ContractId YapHolding] -> Script ()
sendOffer w s r a ins = do
  now <- getTime
  _ <- submit (actAs s <> disclose w.tfD) (transferCmd w now s r a ins)
  pure ()

pendingOffers : World -> Script [(ContractId YapTransferInstruction, YapTransferInstruction)]
pendingOffers w = query @YapTransferInstruction w.admin

acceptOffer : ContractId YapTransferInstruction -> Commands TI.TransferInstructionResult
acceptOffer c = exerciseCmd (toInterfaceContractId @TI.TransferInstruction c) TI.TransferInstruction_Accept with extraArgs = noExtra

withdrawOffer : ContractId YapTransferInstruction -> Commands TI.TransferInstructionResult
withdrawOffer c = exerciseCmd (toInterfaceContractId @TI.TransferInstruction c) TI.TransferInstruction_Withdraw with extraArgs = noExtra

rejectOffer : ContractId YapTransferInstruction -> Commands TI.TransferInstructionResult
rejectOffer c = exerciseCmd (toInterfaceContractId @TI.TransferInstruction c) TI.TransferInstruction_Reject with extraArgs = noExtra

allocateCmdFull : World -> Time -> Party -> Party -> Party -> Text -> Decimal -> [ContractId YapHolding] -> Party -> Party -> RelTime -> RelTime -> RelTime -> Commands AI.AllocationInstructionResult
allocateCmdFull w now s r executor ref a ins expAdmin instAdmin reqOff allocOff settleOff =
  exerciseCmd (toInterfaceContractId @AI.AllocationFactory w.af) AI.AllocationFactory_Allocate with
    expectedAdmin = expAdmin
    allocation = A.AllocationSpecification with
      settlement = A.SettlementInfo with
        executor
        settlementRef = A.Reference with id = ref, cid = None
        requestedAt = addRelTime now reqOff
        allocateBefore = addRelTime now allocOff
        settleBefore = addRelTime now settleOff
        meta = M.emptyMetadata
      transferLegId = "leg-1"
      transferLeg = A.TransferLeg with
        sender = s
        receiver = r
        amount = a
        instrumentId = yapInstrumentId instAdmin
        meta = M.emptyMetadata
    requestedAt = addRelTime now reqOff
    inputHoldingCids = map toInterfaceContractId ins
    extraArgs = noExtra

allocateCmd : World -> Time -> Party -> Party -> Party -> Text -> Decimal -> [ContractId YapHolding] -> Commands AI.AllocationInstructionResult
allocateCmd w now s r executor ref a ins = allocateCmdFull w now s r executor ref a ins w.admin w.admin (seconds (-30)) (hours 1) (hours 2)

-- creates an allocation and returns the one matching executor / sender / receiver / reference
doAllocateFull : World -> Party -> Party -> Party -> Text -> Decimal -> [ContractId YapHolding] -> Script (ContractId YapAllocation)
doAllocateFull w s r executor ref a ins = do
  now <- getTime
  _ <- submit (actAs s <> disclose w.afD) (allocateCmd w now s r executor ref a ins)
  allocs <- query @YapAllocation w.admin
  case [ c | (c, x) <- allocs
           , x.allocation.settlement.settlementRef.id == ref
           , x.allocation.settlement.executor == executor
           , x.allocation.transferLeg.sender == s
           , x.allocation.transferLeg.receiver == r ] of
    (c :: _) -> pure c
    [] -> abort ("allocation not found for " <> ref)

doAllocate : World -> Party -> Party -> Text -> Decimal -> [ContractId YapHolding] -> Script (ContractId YapAllocation)
doAllocate w s r ref a ins = doAllocateFull w s r w.admin ref a ins

executeAlloc : ContractId YapAllocation -> Commands A.Allocation_ExecuteTransferResult
executeAlloc c = exerciseCmd (toInterfaceContractId @A.Allocation c) A.Allocation_ExecuteTransfer with extraArgs = noExtra

withdrawAlloc : ContractId YapAllocation -> Commands A.Allocation_WithdrawResult
withdrawAlloc c = exerciseCmd (toInterfaceContractId @A.Allocation c) A.Allocation_Withdraw with extraArgs = noExtra

execViaAuthority : ContractId YapSettlementAuthority -> ContractId YapAllocation -> Commands A.Allocation_ExecuteTransferResult
execViaAuthority auth alloc = exerciseCmd auth YapSettlement_Execute with
  allocationCid = toInterfaceContractId @A.Allocation alloc
  extraArgs = noExtra

cancelViaAuthority : ContractId YapSettlementAuthority -> ContractId YapAllocation -> Commands A.Allocation_CancelResult
cancelViaAuthority auth alloc = exerciseCmd auth YapSettlement_Cancel with
  allocationCid = toInterfaceContractId @A.Allocation alloc
  extraArgs = noExtra

-- ---------------------------------------------------------------------------------------------------------
-- transfers

testOfferAccept : Script ()
testOfferAccept = do
  w <- setup
  h <- mint w w.alice 100.0
  sendOffer w w.alice w.bob 30.0 [h]
  [(i, _)] <- pendingOffers w
  expectBalance (balance w w.alice) 70.0 "sender keeps the change while the offer is pending"
  expectBalance (balance w w.bob) 0.0 "receiver has nothing before accepting"
  _ <- submit w.bob (acceptOffer i)
  expectBalance (balance w w.bob) 30.0 "receiver holds 30 after accepting"
  expectBalance (balance w w.alice) 70.0 "sender has 70"
  expectBalance (supplyAll w) 100.0 "supply unchanged"

testRejectAndWithdrawReturnFunds : Script ()
testRejectAndWithdrawReturnFunds = do
  w <- setup
  h <- mint w w.alice 10.0
  sendOffer w w.alice w.bob 4.0 [h]
  [(i, _)] <- pendingOffers w
  _ <- submit w.bob (rejectOffer i)
  expectBalance (balance w w.alice) 10.0 "reject returns the funds"
  hs <- freeOf w w.alice
  sendOffer w w.alice w.bob 3.0 (map fst hs)
  [(j, _)] <- pendingOffers w
  _ <- submit w.alice (withdrawOffer j)
  expectBalance (balance w w.alice) 10.0 "withdraw returns the funds"
  expectBalance (supplyAll w) 10.0 "supply unchanged"

testOnlyReceiverAccepts : Script ()
testOnlyReceiverAccepts = do
  w <- setup
  h <- mint w w.alice 10.0
  sendOffer w w.alice w.bob 4.0 [h]
  [(i, _)] <- pendingOffers w
  submitMustFail w.alice (acceptOffer i)
  submitMustFail w.admin (acceptOffer i)

testAcceptAfterExpiryFails : Script ()
testAcceptAfterExpiryFails = do
  w <- setup
  h <- mint w w.alice 10.0
  sendOffer w w.alice w.bob 4.0 [h]
  [(i, _)] <- pendingOffers w
  passTime (hours 2)
  submitMustFail w.bob (acceptOffer i)
  -- the sender can still get the money back after the expiry
  _ <- submit w.alice (withdrawOffer i)
  expectBalance (balance w w.alice) 10.0 "withdraw after expiry works"

testTransferGuards : Script ()
testTransferGuards = do
  w <- setup
  h <- mint w w.alice 10.0
  hb <- mint w w.bob 5.0
  now <- getTime
  let go s r a ins = submitMustFail (actAs s <> disclose w.tfD) (transferCmd w now s r a ins)
  go w.alice w.bob 0.0000001 [h]          -- 7 decimals
  go w.alice w.bob 0.0 [h]                -- zero
  go w.alice w.bob (-1.0) [h]             -- negative
  go w.alice w.bob 11.0 [h]               -- more than the inputs
  go w.alice w.bob 1.0 []                 -- no inputs
  go w.alice w.bob 1.0 [hb]               -- somebody else's holding
  go w.bob w.alice 1.0 [h]                -- alice's holding, bob as sender
  expectBalance (supplyAll w) 15.0 "nothing moved"

testStaleDatesAndWrongAdminFail : Script ()
testStaleDatesAndWrongAdminFail = do
  w <- setup
  h <- mint w w.alice 10.0
  now <- getTime
  let mk exp adm = exerciseCmd (toInterfaceContractId @TI.TransferFactory w.tf) TI.TransferFactory_Transfer with
        expectedAdmin = adm
        transfer = TI.Transfer with
          sender = w.alice
          receiver = w.bob
          amount = 1.0
          instrumentId = yapInstrumentId w.admin
          requestedAt = addRelTime now (seconds (-30))
          executeBefore = exp
          inputHoldingCids = [toInterfaceContractId h]
          meta = M.emptyMetadata
        extraArgs = noExtra
  submitMustFail (actAs w.alice <> disclose w.tfD) (mk (addRelTime now (seconds (-1))) w.admin)   -- executeBefore in the past
  submitMustFail (actAs w.alice <> disclose w.tfD) (mk (addRelTime now (hours 1)) w.bob)           -- wrong expectedAdmin
  expectBalance (supplyAll w) 10.0 "nothing moved"

testSelfTransferCompletesAtOnce : Script ()
testSelfTransferCompletesAtOnce = do
  w <- setup
  h <- mint w w.alice 10.0
  sendOffer w w.alice w.alice 4.0 [h]
  ps <- pendingOffers w
  assertMsg "no pending instruction for a self transfer" (null ps)
  expectBalance (balance w w.alice) 10.0 "balance unchanged"

testDirectTransferWithPreapproval : Script ()
testDirectTransferWithPreapproval = do
  w <- setup
  h <- mint w w.alice 10.0
  h2 <- mint w w.alice 1.0
  adm <- submit w.admin do createCmd YapAdmin with admin = w.admin
  pre <- submit w.admin do exerciseCmd adm YapAdmin_CreatePreapproval with receiver = w.bob
  Some preD <- queryDisclosure w.admin pre
  now <- getTime
  let ctx = M.ExtraArgs with
        context = M.ChoiceContext with values = TextMap.fromList [(preapprovalKey, M.AV_ContractId (coerceContractId pre))]
        meta = M.emptyMetadata
  let mk r a h = exerciseCmd (toInterfaceContractId @TI.TransferFactory w.tf) TI.TransferFactory_Transfer with
        expectedAdmin = w.admin
        transfer = TI.Transfer with
          sender = w.alice
          receiver = r
          amount = a
          instrumentId = yapInstrumentId w.admin
          requestedAt = addRelTime now (seconds (-30))
          executeBefore = addRelTime now (hours 1)
          inputHoldingCids = [toInterfaceContractId h]
          meta = M.emptyMetadata
        extraArgs = ctx
  -- a preapproval for bob cannot be used to pay somebody else
  submitMustFail (actAs w.alice <> disclose w.tfD <> disclose preD) (mk w.admin 1.0 h2)
  _ <- submit (actAs w.alice <> disclose w.tfD <> disclose preD) (mk w.bob 6.0 h)
  ps <- pendingOffers w
  assertMsg "direct: no pending instruction" (null ps)
  expectBalance (balance w w.bob) 6.0 "receiver credited at once"

-- ---------------------------------------------------------------------------------------------------------
-- holdings: split / merge / burn

testSplitMergeBurn : Script ()
testSplitMergeBurn = do
  w <- setup
  h <- mint w w.alice 10.0
  (a, b) <- submit w.alice do exerciseCmd h YapHolding_Split with splitAmount = 3.0
  expectBalance (balance w w.alice) 10.0 "split keeps the total"
  m <- submit w.alice do exerciseCmd a YapHolding_Merge with otherCids = [b]
  hs <- freeOf w w.alice
  assertMsg "merge leaves one holding" (length hs == 1)
  expectBalance (balance w w.alice) 10.0 "merge keeps the total"
  submitMustFail w.alice do exerciseCmd m YapHolding_Split with splitAmount = 10.0          -- not strictly less
  submitMustFail w.alice do exerciseCmd m YapHolding_Split with splitAmount = 0.0
  submitMustFail w.alice do exerciseCmd m YapHolding_Split with splitAmount = 0.0000001     -- 7 decimals
  submitMustFail w.bob do exerciseCmd m YapHolding_Split with splitAmount = 1.0             -- not the owner
  submitMustFail w.admin do exerciseCmd m YapHolding_Burn                                    -- admin cannot use the custom Burn
  _ <- submit w.alice do exerciseCmd m YapHolding_Burn
  expectBalance (supplyAll w) 0.0 "owner burn removes the amount"

testMergeGuards : Script ()
testMergeGuards = do
  w <- setup
  a <- mint w w.alice 5.0
  b <- mint w w.alice 2.0
  c <- mint w w.bob 7.0
  submitMustFail w.alice do exerciseCmd a YapHolding_Merge with otherCids = [b, b]   -- the same holding twice
  submitMustFail w.alice do exerciseCmd a YapHolding_Merge with otherCids = [a]      -- with itself
  submitMustFail w.alice do exerciseCmd a YapHolding_Merge with otherCids = [c]      -- somebody else's
  expectBalance (supplyAll w) 14.0 "nothing moved"

-- ---------------------------------------------------------------------------------------------------------
-- allocations and locks

testAllocationExecute : Script ()
testAllocationExecute = do
  w <- setup
  h <- mint w w.alice 10.0
  alloc <- doAllocate w w.alice w.bob "ref-1" 4.0 [h]
  expectBalance (balance w w.alice) 6.0 "change returned, 4 are locked"
  locked <- lockedOf w w.alice
  assertMsg "exactly one locked holding" (length locked == 1)
  expectBalance (supplyAll w) 10.0 "locked funds are still supply"
  -- executor + sender + receiver must all act
  submitMustFail (actAs [w.admin, w.alice]) (executeAlloc alloc)
  submitMustFail (actAs [w.admin, w.bob]) (executeAlloc alloc)
  _ <- submit (actAs [w.admin, w.alice, w.bob]) (executeAlloc alloc)
  expectBalance (balance w w.bob) 4.0 "receiver paid"
  lockedAfter <- lockedOf w w.alice
  assertMsg "no locked holding left" (null lockedAfter)
  expectBalance (supplyAll w) 10.0 "supply unchanged"

testLockedHoldingCannotBeTouched : Script ()
testLockedHoldingCannotBeTouched = do
  w <- setup
  h <- mint w w.alice 10.0
  _ <- doAllocate w w.alice w.bob "ref-2" 4.0 [h]
  other <- mint w w.alice 1.0
  [(l, _)] <- lockedOf w w.alice
  submitMustFail w.alice do exerciseCmd l YapHolding_Burn
  submitMustFail w.alice do exerciseCmd l YapHolding_Split with splitAmount = 1.0
  submitMustFail w.alice do exerciseCmd l YapHolding_Merge with otherCids = [other]
  submitMustFail w.alice do exerciseCmd other YapHolding_Merge with otherCids = [l]
  now <- getTime
  submitMustFail (actAs w.alice <> disclose w.tfD) (transferCmd w now w.alice w.bob 1.0 [l])
  submitMustFail (actAs w.alice <> disclose w.afD) (allocateCmd w now w.alice w.bob w.admin "ref-3" 1.0 [l])

testSpentHoldingCannotBeAllocatedAgain : Script ()
testSpentHoldingCannotBeAllocatedAgain = do
  w <- setup
  h <- mint w w.alice 10.0
  _ <- doAllocate w w.alice w.bob "ref-4" 4.0 [h]
  now <- getTime
  submitMustFail (actAs w.alice <> disclose w.afD) (allocateCmd w now w.alice w.bob w.admin "ref-5" 4.0 [h])   -- h is gone

testWithdrawReleasesAndOnlySenderCan : Script ()
testWithdrawReleasesAndOnlySenderCan = do
  w <- setup
  h <- mint w w.alice 10.0
  alloc <- doAllocate w w.alice w.bob "ref-6" 4.0 [h]
  submitMustFail w.bob (withdrawAlloc alloc)
  submitMustFail w.admin (withdrawAlloc alloc)
  _ <- submit w.alice (withdrawAlloc alloc)
  expectBalance (balance w w.alice) 10.0 "all 10 back and unlocked"
  locked <- lockedOf w w.alice
  assertMsg "no locked holding" (null locked)

testSettlementWindow : Script ()
testSettlementWindow = do
  w <- setup
  h <- mint w w.alice 10.0
  alloc <- doAllocate w w.alice w.bob "ref-7" 4.0 [h]
  passTime (hours 3)    -- past settleBefore (2 h)
  submitMustFail (actAs [w.admin, w.alice, w.bob]) (executeAlloc alloc)
  -- an expired lock no longer blocks the owner (see testExpiredAllocationLockNoLongerBlocksTheOwner); withdrawing still works
  _ <- submit w.alice (withdrawAlloc alloc)
  expectBalance (balance w w.alice) 10.0 "withdraw after the window releases everything"

-- ---------------------------------------------------------------------------------------------------------
-- issuer powers (documented behaviour)

testIssuerPowers : Script ()
testIssuerPowers = do
  w <- setup
  h <- mint w w.alice 10.0
  adm <- submit w.admin do createCmd YapAdmin with admin = w.admin
  -- mint only by the admin, precision enforced
  submitMustFail w.alice do exerciseCmd adm YapAdmin_Mint with recipient = w.alice, amount = 1.0
  submitMustFail w.admin do exerciseCmd adm YapAdmin_Mint with recipient = w.alice, amount = 0.0000001
  submitMustFail w.admin do exerciseCmd adm YapAdmin_Mint with recipient = w.alice, amount = 0.0
  -- FINDING: the admin is the sole signatory of every holding, so the built-in Archive lets it destroy any balance
  submit w.admin do archiveCmd h
  expectBalance (supplyAll w) 0.0 "admin could destroy alice's holding"

testAdminAloneCannotArchiveInstructionOrAllocation : Script ()
testAdminAloneCannotArchiveInstructionOrAllocation = do
  w <- setup
  h <- mint w w.alice 10.0
  h2 <- mint w w.alice 5.0
  sendOffer w w.alice w.bob 3.0 [h]
  [(i, _)] <- pendingOffers w
  submitMustFail w.admin do archiveCmd i
  alloc <- doAllocate w w.alice w.bob "ref-8" 2.0 [h2]
  submitMustFail w.admin do archiveCmd alloc

-- ---------------------------------------------------------------------------------------------------------
-- delegated settlement

delegate : World -> Text -> Time -> Script (ContractId YapSettlementAuthority)
delegate w ref expires = do
  p <- submit w.alice do
    createCmd YapSettlementProposal with
      executor = w.admin
      sender = w.alice
      receiver = w.bob
      settlementRefId = ref
      expiresAt = expires
  submit w.bob do exerciseCmd p YapSettlementProposal_Accept

testDelegatedSettlement : Script ()
testDelegatedSettlement = do
  w <- setup
  now <- getTime
  h <- mint w w.alice 10.0
  auth <- delegate w "ref-9" (addRelTime now (hours 5))
  alloc <- doAllocate w w.alice w.bob "ref-9" 4.0 [h]
  -- the executor ALONE settles
  _ <- submit w.admin (execViaAuthority auth alloc)
  expectBalance (balance w w.bob) 4.0 "receiver paid by the executor alone"
  -- the authority is non-consuming but the allocation is gone: no second settlement
  submitMustFail w.admin (execViaAuthority auth alloc)

testDelegationIsScoped : Script ()
testDelegationIsScoped = do
  w <- setup
  now <- getTime
  h <- mint w w.alice 10.0
  auth <- delegate w "ref-10" (addRelTime now (hours 5))
  other <- doAllocate w w.alice w.bob "another-settlement" 4.0 [h]
  submitMustFail w.admin (execViaAuthority auth other)
  submitMustFail w.alice (execViaAuthority auth other)     -- only the executor may use it
  submitMustFail w.bob (cancelViaAuthority auth other)

testDelegationRevocationAndExpiry : Script ()
testDelegationRevocationAndExpiry = do
  w <- setup
  now <- getTime
  h <- mint w w.alice 10.0
  h2 <- mint w w.alice 10.0
  auth <- delegate w "ref-11" (addRelTime now (hours 5))
  alloc <- doAllocate w w.alice w.bob "ref-11" 4.0 [h]
  submitMustFail w.admin do exerciseCmd auth YapSettlement_RevokeBySender              -- the executor cannot revoke
  submitMustFail w.bob do exerciseCmd auth YapSettlement_RevokeBySender                -- wrong role
  submit w.bob do exerciseCmd auth YapSettlement_RevokeByReceiver                      -- the receiver alone can
  submitMustFail w.admin (execViaAuthority auth alloc)
  auth2 <- delegate w "ref-11" (addRelTime now (hours 5))
  submit w.alice do exerciseCmd auth2 YapSettlement_RevokeBySender                     -- so can the sender alone
  -- an authority past its expiry cannot be used
  auth3 <- delegate w "ref-11" (addRelTime now (hours 1))
  passTime (hours 2)
  submitMustFail w.admin (execViaAuthority auth3 alloc)
  _ <- submit w.alice (withdrawAlloc alloc)
  expectBalance (balance w w.alice) 20.0 "nothing was settled, alice has everything back"
  _ <- pure h2
  pure ()

testCancelThroughAuthority : Script ()
testCancelThroughAuthority = do
  w <- setup
  now <- getTime
  h <- mint w w.alice 10.0
  auth <- delegate w "ref-12" (addRelTime now (hours 5))
  alloc <- doAllocate w w.alice w.bob "ref-12" 4.0 [h]
  _ <- submit w.admin (cancelViaAuthority auth alloc)
  expectBalance (balance w w.alice) 10.0 "executor cancel returns the funds to the sender"
  expectBalance (balance w w.bob) 0.0 "receiver got nothing"

testProposalRules : Script ()
testProposalRules = do
  w <- setup
  now <- getTime
  submitMustFail w.alice do
    createCmd YapSettlementProposal with
      executor = w.admin
      sender = w.alice
      receiver = w.alice
      settlementRefId = "x"
      expiresAt = addRelTime now (hours 1)
  -- an expired proposal cannot be accepted
  p <- submit w.alice do
    createCmd YapSettlementProposal with
      executor = w.admin
      sender = w.alice
      receiver = w.bob
      settlementRefId = "y"
      expiresAt = addRelTime now (hours 1)
  passTime (hours 2)
  submitMustFail w.bob do exerciseCmd p YapSettlementProposal_Accept

-- ---------------------------------------------------------------------------------------------------------
-- added after the first mutation run: rules that no test protected on their own

-- the holding is DISCLOSED to alice, so only the ownership rule inside the contract can stop her
testForeignAndMixedHoldings : Script ()
testForeignAndMixedHoldings = do
  w <- setup
  admin2 <- allocateParty "admin2"
  ha <- mint w w.alice 5.0
  hb <- mint w w.bob 7.0
  Some hbD <- queryDisclosure w.admin hb
  now <- getTime
  submitMustFail (actAs w.alice <> disclose w.tfD <> disclose hbD) (transferCmd w now w.alice w.bob 1.0 [hb])
  submitMustFail (actAs w.alice <> disclose w.afD <> disclose hbD) (allocateCmd w now w.alice w.bob w.admin "f" 1.0 [hb])
  submitMustFail (actAs w.alice <> disclose hbD) do exerciseCmd ha YapHolding_Merge with otherCids = [hb]
  -- a holding of ANOTHER issuer with the same owner must not be mixed in
  h2 <- submit admin2 do createCmd YapHolding with admin = admin2, owner = w.alice, amount = 3.0, lock = None
  Some h2D <- queryDisclosure admin2 h2
  submitMustFail (actAs w.alice <> disclose h2D) do exerciseCmd ha YapHolding_Merge with otherCids = [h2]
  submitMustFail (actAs w.alice <> disclose w.tfD <> disclose h2D) (transferCmd w now w.alice w.bob 1.0 [h2])
  expectBalance (balance w w.bob) 7.0 "bob untouched"

testPreapprovalOfAnotherIssuerIsRejected : Script ()
testPreapprovalOfAnotherIssuerIsRejected = do
  w <- setup
  admin2 <- allocateParty "admin2"
  h <- mint w w.alice 10.0
  adm2 <- submit admin2 do createCmd YapAdmin with admin = admin2
  pre2 <- submit admin2 do exerciseCmd adm2 YapAdmin_CreatePreapproval with receiver = w.bob
  Some pre2D <- queryDisclosure admin2 pre2
  now <- getTime
  let ctx = M.ExtraArgs with
        context = M.ChoiceContext with values = TextMap.fromList [(preapprovalKey, M.AV_ContractId (coerceContractId pre2))]
        meta = M.emptyMetadata
  submitMustFail (actAs w.alice <> disclose w.tfD <> disclose pre2D) (transferCmdFull w now w.alice w.bob 1.0 [h] w.admin w.admin (seconds (-30)) (hours 1) ctx)

testTransferFieldGuards : Script ()
testTransferFieldGuards = do
  w <- setup
  h <- mint w w.alice 10.0
  now <- getTime
  let go expA instA reqOff execOff = submitMustFail (actAs w.alice <> disclose w.tfD) (transferCmdFull w now w.alice w.bob 1.0 [h] expA instA reqOff execOff noExtra)
  go w.admin w.alice (seconds (-30)) (hours 1)     -- instrument of another admin
  go w.admin w.admin (seconds 30) (hours 1)        -- requestedAt in the future
  expectBalance (supplyAll w) 10.0 "nothing moved"

testAllocationFieldGuards : Script ()
testAllocationFieldGuards = do
  w <- setup
  h <- mint w w.alice 10.0
  now <- getTime
  let go expA instA a reqOff allocOff settleOff = submitMustFail (actAs w.alice <> disclose w.afD) (allocateCmdFull w now w.alice w.bob w.admin "g" a [h] expA instA reqOff allocOff settleOff)
  go w.bob w.admin 1.0 (seconds (-30)) (hours 1) (hours 2)          -- wrong expectedAdmin
  go w.admin w.alice 1.0 (seconds (-30)) (hours 1) (hours 2)        -- instrument of another admin
  go w.admin w.admin 0.0000001 (seconds (-30)) (hours 1) (hours 2)  -- 7 decimals
  go w.admin w.admin 1.0 (seconds 30) (hours 1) (hours 2)           -- requestedAt in the future
  go w.admin w.admin 1.0 (seconds (-30)) (seconds (-1)) (hours 2)   -- allocateBefore already passed
  go w.admin w.admin 1.0 (seconds (-30)) (hours 1) (hours 1)        -- settleBefore not after allocateBefore
  expectBalance (supplyAll w) 10.0 "nothing moved"

-- one authority (alice -> bob, executor admin, ref "ref-m"); every allocation below differs from it in exactly ONE respect
testDelegationMismatches : Script ()
testDelegationMismatches = do
  w <- setup
  now <- getTime
  h <- mint w w.alice 10.0
  hc <- mint w w.carol 10.0
  auth <- delegate w "ref-m" (addRelTime now (hours 5))
  a1 <- doAllocateFull w w.alice w.bob w.bob "ref-m" 1.0 [h]            -- another executor
  submitMustFail w.admin (execViaAuthority auth a1)
  a2 <- doAllocateFull w w.carol w.bob w.admin "ref-m" 1.0 [hc]          -- another sender
  submitMustFail w.admin (execViaAuthority auth a2)
  hs <- freeOf w w.alice
  a3 <- doAllocateFull w w.alice w.carol w.admin "ref-m" 1.0 (map fst hs)   -- another receiver
  submitMustFail w.admin (execViaAuthority auth a3)
  expectBalance (balance w w.bob) 0.0 "nothing was settled"

-- the allocation window (2 h) is still open when the 1 h authority has expired
testDelegationExpiresOnItsOwn : Script ()
testDelegationExpiresOnItsOwn = do
  w <- setup
  now <- getTime
  h <- mint w w.alice 10.0
  auth <- delegate w "ref-e" (addRelTime now (hours 1))
  alloc <- doAllocate w w.alice w.bob "ref-e" 4.0 [h]
  passTime (minutes 90)
  submitMustFail w.admin (execViaAuthority auth alloc)
  -- the same settlement still works with all three parties acting (window still open)
  _ <- submit (actAs [w.admin, w.alice, w.bob]) (executeAlloc alloc)
  expectBalance (balance w w.bob) 4.0 "paid without the delegation"

-- ---------------------------------------------------------------------------------------------------------
-- burn / mint (Splice.Api.Token.BurnMintV1)

burnMintCmd : World -> ContractId YapBurnMintFactory -> Party -> InstrumentIdArg -> [ContractId YapHolding] -> [(Party, Decimal)] -> [Party] -> Commands BM.BurnMintFactory_BurnMintResult
burnMintCmd w bf expAdmin inst ins outs actors =
  exerciseCmd (toInterfaceContractId @BM.BurnMintFactory bf) BM.BurnMintFactory_BurnMint with
    expectedAdmin = expAdmin
    instrumentId = yapInstrumentId inst
    inputHoldingCids = map toInterfaceContractId ins
    outputs = [ BM.BurnMintOutput with owner = o, amount = a, context = M.ChoiceContext with values = TextMap.empty | (o, a) <- outs ]
    extraActors = actors
    extraArgs = noExtra

type InstrumentIdArg = Party

bmSetup : Script (World, ContractId YapBurnMintFactory)
bmSetup = do
  w <- setup
  bf <- submit w.admin do createCmd YapBurnMintFactory with admin = w.admin
  pure (w, bf)

testBurnMintReshapeKeepsSupply : Script ()
testBurnMintReshapeKeepsSupply = do
  (w, bf) <- bmSetup
  h <- mint w w.alice 10.0
  r <- submit (actAs [w.admin, w.alice]) (burnMintCmd w bf w.admin w.admin [h] [(w.alice, 4.0), (w.alice, 6.0)] [w.alice])
  assertMsg "two output holdings reported" (length r.outputCids == 2)
  hs <- freeOf w w.alice
  assertMsg "alice has exactly the two new holdings" (length hs == 2)
  expectBalance (balance w w.alice) 10.0 "same total"
  expectBalance (supplyAll w) 10.0 "supply unchanged"

testBurnMintNetMintAndBurn : Script ()
testBurnMintNetMintAndBurn = do
  (w, bf) <- bmSetup
  h <- mint w w.alice 10.0
  -- pure mint: no inputs, nobody but the admin needs to act
  _ <- submit w.admin (burnMintCmd w bf w.admin w.admin [] [(w.bob, 5.0)] [])
  expectBalance (balance w w.bob) 5.0 "minted to bob without his consent (a credit)"
  expectBalance (supplyAll w) 15.0 "supply grew by the mint"
  -- pure burn of alice's holding, with alice as extra actor
  _ <- submit (actAs [w.admin, w.alice]) (burnMintCmd w bf w.admin w.admin [h] [] [w.alice])
  expectBalance (balance w w.alice) 0.0 "alice's holding burnt"
  expectBalance (supplyAll w) 5.0 "supply shrank by the burn"

testBurnMintGuards : Script ()
testBurnMintGuards = do
  (w, bf) <- bmSetup
  h <- mint w w.alice 10.0
  h2 <- mint w w.alice 5.0
  let go expAdmin inst ins outs actors = submitMustFail (actAs (w.admin :: actors)) (burnMintCmd w bf expAdmin inst ins outs actors)
  go w.admin w.admin [h] [(w.alice, 10.0)] []                       -- owner of the burnt holding did not consent
  go w.admin w.admin [h] [(w.alice, 10.0)] [w.bob]                  -- the wrong party as extra actor
  go w.bob w.admin [h] [(w.alice, 10.0)] [w.alice]                  -- wrong expectedAdmin
  go w.admin w.bob [h] [(w.alice, 10.0)] [w.alice]                  -- instrument of another admin
  go w.admin w.admin [h] [(w.alice, 0.0)] [w.alice]                 -- zero output
  go w.admin w.admin [h] [(w.alice, -1.0)] [w.alice]                -- negative output
  go w.admin w.admin [h] [(w.alice, 0.0000001)] [w.alice]           -- 7 decimals
  go w.admin w.admin [] [] []                                       -- nothing at all
  go w.admin w.admin [h, h] [(w.alice, 10.0)] [w.alice]             -- the same input twice
  -- alice alone cannot use it: the admin always controls the choice
  submitMustFail w.alice (burnMintCmd w bf w.admin w.admin [h2] [(w.alice, 5.0)] [w.alice])
  expectBalance (supplyAll w) 15.0 "nothing moved"

testBurnMintRefusesLockedInputs : Script ()
testBurnMintRefusesLockedInputs = do
  (w, bf) <- bmSetup
  h <- mint w w.alice 10.0
  _ <- doAllocate w w.alice w.bob "bm-lock" 4.0 [h]
  [(l, _)] <- lockedOf w w.alice
  submitMustFail (actAs [w.admin, w.alice]) (burnMintCmd w bf w.admin w.admin [l] [] [w.alice])
  expectBalance (supplyAll w) 10.0 "locked funds untouched"

testBurnMintRefusesOutputContext : Script ()
testBurnMintRefusesOutputContext = do
  (w, bf) <- bmSetup
  h <- mint w w.alice 10.0
  let ctx = M.ChoiceContext with values = TextMap.fromList [("lock", M.AV_Bool True)]
  submitMustFail (actAs [w.admin, w.alice]) do
    exerciseCmd (toInterfaceContractId @BM.BurnMintFactory bf) BM.BurnMintFactory_BurnMint with
      expectedAdmin = w.admin
      instrumentId = yapInstrumentId w.admin
      inputHoldingCids = [toInterfaceContractId h]
      outputs = [BM.BurnMintOutput with owner = w.alice, amount = 10.0, context = ctx]
      extraActors = [w.alice]
      extraArgs = noExtra
  expectBalance (supplyAll w) 10.0 "nothing moved"

-- ---------------------------------------------------------------------------------------------------------
-- Token Standard V2 (CIP-0112): the same templates also answer to the V2 interfaces

v2Acct : Party -> H2.Account
v2Acct p = H2.Account with owner = Some p, provider = None, id = ""

transferV2Cmd : World -> Time -> [Party] -> H2.Account -> H2.Account -> Decimal -> H2.InstrumentId -> [ContractId YapHolding] -> M.ExtraArgs -> Commands TI2.TransferInstructionResult
transferV2Cmd w now acts s r a inst ins ex = transferV2CmdT w now (seconds (-30)) (hours 1) acts s r a inst ins ex

transferV2CmdT : World -> Time -> RelTime -> RelTime -> [Party] -> H2.Account -> H2.Account -> Decimal -> H2.InstrumentId -> [ContractId YapHolding] -> M.ExtraArgs -> Commands TI2.TransferInstructionResult
transferV2CmdT w now reqOff execOff acts s r a inst ins ex =
  exerciseCmd (toInterfaceContractId @TI2.TransferFactory w.tf) TI2.TransferFactory_Transfer with
    transfer = TI2.Transfer with
      sender = s
      receiver = r
      amount = a
      instrumentId = inst
      requestedAt = addRelTime now reqOff
      executeBefore = addRelTime now execOff
      inputHoldingCids = map toInterfaceContractId ins
      meta = M.emptyMetadata
    actors = acts
    extraArgs = ex

offerV2 : World -> Party -> Party -> Decimal -> [ContractId YapHolding] -> Script ()
offerV2 w s r a ins = do
  now <- getTime
  _ <- submit (actAs s <> disclose w.tfD) (transferV2Cmd w now [s] (v2Acct s) (v2Acct r) a (yapInstrumentIdV2 w.admin) ins noExtra)
  pure ()

acceptV2 : [Party] -> ContractId YapTransferInstruction -> Commands TI2.TransferInstructionResult
acceptV2 acts c = exerciseCmd (toInterfaceContractId @TI2.TransferInstruction c) TI2.TransferInstruction_Accept with actors = acts, extraArgs = noExtra

rejectV2 : [Party] -> ContractId YapTransferInstruction -> Commands TI2.TransferInstructionResult
rejectV2 acts c = exerciseCmd (toInterfaceContractId @TI2.TransferInstruction c) TI2.TransferInstruction_Reject with actors = acts, extraArgs = noExtra

withdrawV2 : [Party] -> ContractId YapTransferInstruction -> Commands TI2.TransferInstructionResult
withdrawV2 acts c = exerciseCmd (toInterfaceContractId @TI2.TransferInstruction c) TI2.TransferInstruction_Withdraw with actors = acts, extraArgs = noExtra

testV2HoldingViewAndV1Coexist : Script ()
testV2HoldingViewAndV1Coexist = do
  w <- setup
  _ <- mint w w.alice 7.0
  [(_, Some v2)] <- queryInterface @H2.Holding w.alice
  assertMsg "V2 account owner is alice" (v2.account.owner == Some w.alice)
  assertMsg "V2 account has no provider and the default id" (v2.account.provider == None && v2.account.id == "")
  assertMsg "V2 amount" (v2.amount == 7.0)
  assertMsg "V2 instrument admin" (v2.instrumentId.admin == w.admin)
  assertMsg "V2 holding is unlocked" (v2.lock == None)
  [(_, Some v1)] <- queryInterface @H.Holding w.alice
  assertMsg "the V1 view still works next to it" (v1.owner == w.alice && v1.amount == 7.0)

testV2OfferAcceptRejectWithdraw : Script ()
testV2OfferAcceptRejectWithdraw = do
  w <- setup
  h <- mint w w.alice 10.0
  offerV2 w w.alice w.bob 4.0 [h]
  [(i, _)] <- pendingOffers w
  [(_, Some tv)] <- queryInterface @TI2.TransferInstruction w.bob
  assertMsg "V2 view: sender account" (tv.transfer.sender.owner == Some w.alice)
  assertMsg "V2 view: receiver account" (tv.transfer.receiver.owner == Some w.bob)
  assertMsg "V2 view: amount" (tv.transfer.amount == 4.0)
  expectBalance (balance w w.alice) 6.0 "change stays with the sender while pending"
  _ <- submit w.bob (acceptV2 [w.bob] i)
  expectBalance (balance w w.bob) 4.0 "receiver holds 4"
  ps <- pendingOffers w
  assertMsg "the non-consuming V2 choice archived the instruction itself" (null ps)
  -- reject returns the funds
  hs <- freeOf w w.alice
  offerV2 w w.alice w.bob 3.0 (map fst hs)
  [(j, _)] <- pendingOffers w
  _ <- submit w.bob (rejectV2 [w.bob] j)
  expectBalance (balance w w.alice) 6.0 "reject returned the 3"
  -- withdraw returns the funds
  hs2 <- freeOf w w.alice
  offerV2 w w.alice w.bob 2.0 (map fst hs2)
  [(k, _)] <- pendingOffers w
  _ <- submit w.alice (withdrawV2 [w.alice] k)
  expectBalance (balance w w.alice) 6.0 "withdraw returned the 2"
  expectBalance (supplyAll w) 10.0 "supply unchanged"

-- the critical one: V2 lets the caller choose the actors, the holdings' only signatory is the admin
testV2WrongActorsAreRefused : Script ()
testV2WrongActorsAreRefused = do
  w <- setup
  h <- mint w w.alice 10.0
  Some hD <- queryDisclosure w.admin h
  now <- getTime
  -- bob tries to spend ALICE's holding (it is disclosed to him): the sender is not among the actors
  submitMustFail (actAs w.bob <> disclose w.tfD <> disclose hD) (transferV2Cmd w now [w.bob] (v2Acct w.alice) (v2Acct w.bob) 5.0 (yapInstrumentIdV2 w.admin) [h] noExtra)
  -- the same with the receiver pretending to be the sender's account owner
  submitMustFail (actAs w.bob <> disclose w.tfD <> disclose hD) (transferV2Cmd w now [w.bob] (v2Acct w.bob) (v2Acct w.bob) 5.0 (yapInstrumentIdV2 w.admin) [h] noExtra)
  expectBalance (supplyAll w) 10.0 "nothing moved"
  offerV2 w w.alice w.bob 4.0 [h]
  [(i, _)] <- pendingOffers w
  submitMustFail w.alice (acceptV2 [w.alice] i)       -- the sender cannot accept
  submitMustFail w.alice (rejectV2 [w.alice] i)       -- nor reject
  submitMustFail w.bob (withdrawV2 [w.bob] i)         -- the receiver cannot withdraw
  submitMustFail w.admin (acceptV2 [w.admin] i)
  ps <- pendingOffers w
  assertMsg "the instruction is untouched" (length ps == 1)

testV2AccountAndInstrumentRules : Script ()
testV2AccountAndInstrumentRules = do
  w <- setup
  admin2 <- allocateParty "admin2"
  h <- mint w w.alice 10.0
  now <- getTime
  let go s r inst a = submitMustFail (actAs w.alice <> disclose w.tfD) (transferV2Cmd w now [w.alice] s r a inst [h] noExtra)
  let good = yapInstrumentIdV2 w.admin
  go (v2Acct w.alice) (H2.Account with owner = Some w.bob, provider = Some w.admin, id = "") good 1.0   -- an account with a provider
  go (v2Acct w.alice) (H2.Account with owner = Some w.bob, provider = None, id = "savings") good 1.0    -- a non-default account id
  go (v2Acct w.alice) (H2.Account with owner = None, provider = None, id = "") good 1.0                 -- an admin-managed account
  go (H2.Account with owner = None, provider = None, id = "") (v2Acct w.bob) good 1.0
  go (v2Acct w.alice) (v2Acct w.bob) (yapInstrumentIdV2 admin2) 1.0                                  -- another admin's instrument
  go (v2Acct w.alice) (v2Acct w.bob) good 0.0
  go (v2Acct w.alice) (v2Acct w.bob) good (-1.0)
  go (v2Acct w.alice) (v2Acct w.bob) good 0.0000001                                                   -- 7 decimals
  go (v2Acct w.alice) (v2Acct w.bob) good 11.0                                                        -- more than the inputs
  expectBalance (supplyAll w) 10.0 "nothing moved"

testV2AndV1Interoperate : Script ()
testV2AndV1Interoperate = do
  w <- setup
  h <- mint w w.alice 10.0
  -- offered through V2, accepted through V1
  offerV2 w w.alice w.bob 3.0 [h]
  [(i, _)] <- pendingOffers w
  _ <- submit w.bob (acceptOffer i)
  expectBalance (balance w w.bob) 3.0 "V2 offer accepted via V1"
  -- offered through V1, accepted through V2
  hs <- freeOf w w.alice
  sendOffer w w.alice w.bob 2.0 (map fst hs)
  [(j, _)] <- pendingOffers w
  _ <- submit w.bob (acceptV2 [w.bob] j)
  expectBalance (balance w w.bob) 5.0 "V1 offer accepted via V2"
  expectBalance (supplyAll w) 10.0 "supply unchanged"

testV2SelfAndDirectTransfer : Script ()
testV2SelfAndDirectTransfer = do
  w <- setup
  h <- mint w w.alice 10.0
  h2 <- mint w w.alice 1.0
  now <- getTime
  _ <- submit (actAs w.alice <> disclose w.tfD) (transferV2Cmd w now [w.alice] (v2Acct w.alice) (v2Acct w.alice) 4.0 (yapInstrumentIdV2 w.admin) [h] noExtra)
  ps <- pendingOffers w
  assertMsg "a V2 self transfer completes at once" (null ps)
  expectBalance (balance w w.alice) 11.0 "balance unchanged"
  adm <- submit w.admin do createCmd YapAdmin with admin = w.admin
  pre <- submit w.admin do exerciseCmd adm YapAdmin_CreatePreapproval with receiver = w.bob
  Some preD <- queryDisclosure w.admin pre
  let ctx = M.ExtraArgs with
        context = M.ChoiceContext with values = TextMap.fromList [(preapprovalKey, M.AV_ContractId (coerceContractId pre))]
        meta = M.emptyMetadata
  hs <- freeOf w w.alice
  _ <- submit (actAs w.alice <> disclose w.tfD <> disclose preD) (transferV2Cmd w now [w.alice] (v2Acct w.alice) (v2Acct w.bob) 6.0 (yapInstrumentIdV2 w.admin) (map fst hs) ctx)
  expectBalance (balance w w.bob) 6.0 "direct V2 transfer credited at once"
  -- a preapproval for bob cannot pay somebody else
  hs2 <- freeOf w w.alice
  submitMustFail (actAs w.alice <> disclose w.tfD <> disclose preD) (transferV2Cmd w now [w.alice] (v2Acct w.alice) (v2Acct w.admin) 1.0 (yapInstrumentIdV2 w.admin) (map fst hs2) ctx)
  _ <- pure h2
  pure ()

testV2ExpiryAndInputs : Script ()
testV2ExpiryAndInputs = do
  w <- setup
  h <- mint w w.alice 10.0
  hb <- mint w w.bob 5.0
  now <- getTime
  -- somebody else's holding, and no inputs at all
  submitMustFail (actAs w.alice <> disclose w.tfD) (transferV2Cmd w now [w.alice] (v2Acct w.alice) (v2Acct w.bob) 1.0 (yapInstrumentIdV2 w.admin) [hb] noExtra)
  submitMustFail (actAs w.alice <> disclose w.tfD) (transferV2Cmd w now [w.alice] (v2Acct w.alice) (v2Acct w.bob) 1.0 (yapInstrumentIdV2 w.admin) [] noExtra)
  offerV2 w w.alice w.bob 4.0 [h]
  [(i, _)] <- pendingOffers w
  passTime (hours 2)
  submitMustFail w.bob (acceptV2 [w.bob] i)
  _ <- submit w.alice (withdrawV2 [w.alice] i)
  expectBalance (balance w w.alice) 10.0 "withdraw after the expiry works"

-- found by the mutation run: the offer path fails on its own (the instruction needs the sender's signature), the DIRECT path does not.
-- A receiver with a preapproval must not be able to spend somebody else's holding by naming himself in the actors.
testV2DirectPathCannotSpendSomeoneElsesHolding : Script ()
testV2DirectPathCannotSpendSomeoneElsesHolding = do
  w <- setup
  h <- mint w w.alice 10.0
  Some hD <- queryDisclosure w.admin h
  adm <- submit w.admin do createCmd YapAdmin with admin = w.admin
  pre <- submit w.admin do exerciseCmd adm YapAdmin_CreatePreapproval with receiver = w.bob
  Some preD <- queryDisclosure w.admin pre
  now <- getTime
  let ctx = M.ExtraArgs with
        context = M.ChoiceContext with values = TextMap.fromList [(preapprovalKey, M.AV_ContractId (coerceContractId pre))]
        meta = M.emptyMetadata
  submitMustFail (actAs w.bob <> disclose w.tfD <> disclose hD <> disclose preD)
    (transferV2Cmd w now [w.bob] (v2Acct w.alice) (v2Acct w.bob) 10.0 (yapInstrumentIdV2 w.admin) [h] ctx)
  expectBalance (balance w w.alice) 10.0 "alice keeps her money"
  expectBalance (balance w w.bob) 0.0 "bob got nothing"
  -- the owner can of course pay bob that way
  _ <- submit (actAs w.alice <> disclose w.tfD <> disclose preD)
    (transferV2Cmd w now [w.alice] (v2Acct w.alice) (v2Acct w.bob) 10.0 (yapInstrumentIdV2 w.admin) [h] ctx)
  expectBalance (balance w w.bob) 10.0 "the owner's own direct transfer works"

testV2DatesAreChecked : Script ()
testV2DatesAreChecked = do
  w <- setup
  h <- mint w w.alice 10.0
  now <- getTime
  let go reqOff execOff = submitMustFail (actAs w.alice <> disclose w.tfD)
        (transferV2CmdT w now reqOff execOff [w.alice] (v2Acct w.alice) (v2Acct w.bob) 1.0 (yapInstrumentIdV2 w.admin) [h] noExtra)
  go (seconds 60) (hours 1)          -- requestedAt in the future
  go (seconds (-30)) (seconds (-1))  -- executeBefore already passed
  expectBalance (supplyAll w) 10.0 "nothing moved"

testBurnMintPublicFetch : Script ()
testBurnMintPublicFetch = do
  (w, bf) <- bmSetup
  Some bfD <- queryDisclosure w.admin bf
  _ <- submit (actAs w.alice <> disclose bfD) do
    exerciseCmd (toInterfaceContractId @BM.BurnMintFactory bf) BM.BurnMintFactory_PublicFetch with expectedAdmin = w.admin, actor = w.alice
  submitMustFail (actAs w.alice <> disclose bfD) do
    exerciseCmd (toInterfaceContractId @BM.BurnMintFactory bf) BM.BurnMintFactory_PublicFetch with expectedAdmin = w.bob, actor = w.alice

-- ---------------------------------------------------------------------------------------------------------
-- locks: expiry is honoured, voluntary locks, discarding an expired allocation

testExpiredAllocationLockNoLongerBlocksTheOwner : Script ()
testExpiredAllocationLockNoLongerBlocksTheOwner = do
  w <- setup
  h <- mint w w.alice 10.0
  alloc <- doAllocate w w.alice w.bob "exp-1" 4.0 [h]
  [(l, _)] <- lockedOf w w.alice
  submitMustFail w.alice do exerciseCmd l YapHolding_Split with splitAmount = 1.0     -- still locked inside the window
  passTime (hours 3)
  submitMustFail (actAs [w.admin, w.alice, w.bob]) (executeAlloc alloc)                  -- but it can no longer be settled
  _ <- submit w.alice do exerciseCmd l YapHolding_Split with splitAmount = 1.0         -- expired: the owner can use it
  expectBalance (balance w w.alice) 10.0 "both split parts are plain holdings again"
  submitMustFail w.alice (withdrawAlloc alloc)                                           -- the locked holding is gone
  submitMustFail w.bob do exerciseCmd alloc YapAllocation_DiscardExpired               -- only the sender may discard
  _ <- submit w.alice do exerciseCmd alloc YapAllocation_DiscardExpired
  allocs <- query @YapAllocation w.admin
  assertMsg "no allocation left" (null allocs)
  expectBalance (supplyAll w) 10.0 "supply unchanged"

testDiscardNeedsExpiry : Script ()
testDiscardNeedsExpiry = do
  w <- setup
  h <- mint w w.alice 10.0
  alloc <- doAllocate w w.alice w.bob "exp-2" 4.0 [h]
  submitMustFail w.alice do exerciseCmd alloc YapAllocation_DiscardExpired
  _ <- submit w.alice (withdrawAlloc alloc)
  expectBalance (balance w w.alice) 10.0 "withdraw inside the window still works"

testExpiredLockedHoldingIsUsableEverywhere : Script ()
testExpiredLockedHoldingIsUsableEverywhere = do
  w <- setup
  h <- mint w w.alice 10.0
  _ <- doAllocate w w.alice w.bob "exp-3" 4.0 [h]
  [(l, _)] <- lockedOf w w.alice
  passTime (hours 3)
  -- as a transfer input (V1 and V2) ...
  sendOffer w w.alice w.bob 1.0 [l]
  expectBalance (balance w w.alice) 9.0 "the expired-locked holding paid a transfer, change came back unlocked"
  -- ... as a merge partner and for burning
  h2 <- mint w w.alice 2.0
  h3 <- mint w w.alice 3.0
  _ <- submit w.alice do exerciseCmd h2 YapHolding_Merge with otherCids = [h3]
  expectBalance (balance w w.alice) 14.0 "merged"

testVoluntaryLock : Script ()
testVoluntaryLock = do
  w <- setup
  h <- mint w w.alice 10.0
  now <- getTime
  submitMustFail w.bob do exerciseCmd h YapHolding_Lock with holders = [w.bob], expiresAt = addRelTime now (hours 2), context = "x"   -- not the owner
  submitMustFail w.alice do exerciseCmd h YapHolding_Lock with holders = [w.alice], expiresAt = addRelTime now (hours 2), context = "x" -- owner as holder
  submitMustFail w.alice do exerciseCmd h YapHolding_Lock with holders = [w.bob], expiresAt = addRelTime now (seconds (-1)), context = "x" -- already past
  l <- submit w.alice do exerciseCmd h YapHolding_Lock with holders = [w.bob], expiresAt = addRelTime now (hours 2), context = "escrow"
  expectBalance (balance w w.alice) 0.0 "a locked holding is not free"
  -- nothing can move it
  submitMustFail w.alice do exerciseCmd l YapHolding_Split with splitAmount = 1.0
  submitMustFail w.alice do exerciseCmd l YapHolding_Burn
  submitMustFail w.alice do exerciseCmd l YapHolding_Lock with holders = [w.bob], expiresAt = addRelTime now (hours 3), context = "again"
  submitMustFail (actAs w.alice <> disclose w.tfD) (transferCmd w now w.alice w.bob 1.0 [l])
  submitMustFail (actAs w.alice <> disclose w.afD) (allocateCmd w now w.alice w.bob w.admin "vl" 1.0 [l])
  -- the V2 view shows the lock and who holds it
  vs <- queryInterface @H2.Holding w.alice
  assertMsg "the V2 view reports the lock holders" (not (null [ () | (_, Some v) <- vs, Some lk <- [v.lock], lk.holders == [w.bob] ]))
  -- early release: only the holder, and not the owner or the issuer
  submitMustFail w.alice do exerciseCmd l YapHolding_UnlockEarly
  submitMustFail w.admin do exerciseCmd l YapHolding_UnlockEarly
  submitMustFail w.alice do exerciseCmd l YapHolding_UnlockExpired                       -- not expired yet
  _ <- submit w.bob do exerciseCmd l YapHolding_UnlockEarly
  expectBalance (balance w w.alice) 10.0 "released by the holder"
  expectBalance (supplyAll w) 10.0 "supply unchanged"

testPureTimeLockNobodyCanShorten : Script ()
testPureTimeLockNobodyCanShorten = do
  w <- setup
  h <- mint w w.alice 10.0
  now <- getTime
  l <- submit w.alice do exerciseCmd h YapHolding_Lock with holders = [], expiresAt = addRelTime now (hours 1), context = "time lock"
  submitMustFail w.alice do exerciseCmd l YapHolding_UnlockEarly
  submitMustFail w.bob do exerciseCmd l YapHolding_UnlockEarly
  submitMustFail w.admin do exerciseCmd l YapHolding_UnlockEarly
  passTime (hours 2)
  now2 <- getTime
  sendOffer w w.alice w.bob 4.0 [l]                                                         -- after expiry it is spendable without any unlock step
  expectBalance (balance w w.alice) 6.0 "change after the expired lock"
  _ <- pure now2
  pure ()

testUnlockExpiredTidyUp : Script ()
testUnlockExpiredTidyUp = do
  w <- setup
  h <- mint w w.alice 10.0
  now <- getTime
  l <- submit w.alice do exerciseCmd h YapHolding_Lock with holders = [w.bob], expiresAt = addRelTime now (hours 1), context = "tidy"
  passTime (hours 2)
  _ <- submit w.alice do exerciseCmd l YapHolding_UnlockExpired
  expectBalance (balance w w.alice) 10.0 "stale lock record dropped"
  [(u, _)] <- freeOf w w.alice
  submitMustFail w.alice do exerciseCmd u YapHolding_UnlockExpired                       -- nothing to drop

testAllocationLockCannotBeReleasedEarly : Script ()
testAllocationLockCannotBeReleasedEarly = do
  w <- setup
  h <- mint w w.alice 10.0
  _ <- doAllocate w w.alice w.bob "no-early" 4.0 [h]
  [(l, _)] <- lockedOf w w.alice
  submitMustFail w.admin do exerciseCmd l YapHolding_UnlockEarly                          -- the executor holds the lock, but it is not voluntary
  submitMustFail w.alice do exerciseCmd l YapHolding_UnlockEarly
  expectBalance (supplyAll w) 10.0 "nothing moved"

-- ---------------------------------------------------------------------------------------------------------
-- linear vesting

vestAdmin : World -> Script (ContractId YapAdmin)
vestAdmin w = submit w.admin do createCmd YapAdmin with admin = w.admin

-- 100 YAP for bob, linear over 10 days from now, cliff = start unless given
grantVest : World -> ContractId YapAdmin -> Party -> Time -> RelTime -> RelTime -> Bool -> Script (ContractId YapVesting)
grantVest w adm who now cliffAfter finishAfter rev = submit w.admin do
  exerciseCmd adm YapAdmin_GrantVesting with
    beneficiary = who
    amount = 100.0
    start = now
    cliff = addRelTime now cliffAfter
    finish = addRelTime now finishAfter
    revocable = rev

testVestingGrantLocksTheTokens : Script ()
testVestingGrantLocksTheTokens = do
  w <- setup
  adm <- vestAdmin w
  now <- getTime
  v <- grantVest w adm w.bob now (seconds 0) (days 10) True
  expectBalance (balance w w.bob) 0.0 "nothing is free yet"
  [(l, h)] <- lockedOf w w.bob
  assertMsg "the whole grant sits in one locked holding" (h.amount == 100.0 && h.owner == w.bob)
  expectBalance (supplyAll w) 100.0 "the grant is new supply"
  -- the locked remainder cannot be touched by anybody
  submitMustFail w.bob do exerciseCmd l YapHolding_Split with splitAmount = 1.0
  submitMustFail w.bob do exerciseCmd l YapHolding_Burn
  submitMustFail w.bob do exerciseCmd l YapHolding_UnlockEarly
  submitMustFail w.admin do exerciseCmd l YapHolding_UnlockEarly            -- the admin holds the lock but it is not a voluntary one
  submitMustFail (actAs w.bob <> disclose w.tfD) (transferCmd w now w.bob w.alice 1.0 [l])
  -- the V2 view shows it as locked, with the admin as lock holder
  vs <- queryInterface @H2.Holding w.bob
  assertMsg "V2 view: locked by the admin" (not (null [ () | (_, Some hv) <- vs, Some lk <- [hv.lock], lk.holders == [w.admin] ]))
  _ <- pure v
  pure ()

testVestingNothingBeforeTheCliff : Script ()
testVestingNothingBeforeTheCliff = do
  w <- setup
  adm <- vestAdmin w
  now <- getTime
  v <- grantVest w adm w.bob now (days 5) (days 10) True
  submitMustFail w.bob do exerciseCmd v YapVesting_Claim
  passTime (days 4)
  submitMustFail w.bob do exerciseCmd v YapVesting_Claim
  passTime (days 1)                                                             -- the cliff: the share elapsed since the start (5 of 10 days) is released
  (rel, _) <- submit w.bob do exerciseCmd v YapVesting_Claim
  expectBalance (balance w w.bob) 50.0 "half is released at the cliff"
  _ <- pure rel
  pure ()

testVestingIsLinear : Script ()
testVestingIsLinear = do
  w <- setup
  adm <- vestAdmin w
  now <- getTime
  v0 <- grantVest w adm w.bob now (seconds 0) (days 10) True
  submitMustFail w.alice do exerciseCmd v0 YapVesting_Claim                    -- only the beneficiary
  submitMustFail w.admin do exerciseCmd v0 YapVesting_Claim
  passTime (days 1)
  (_, Some v1) <- submit w.bob do exerciseCmd v0 YapVesting_Claim
  expectBalance (balance w w.bob) 10.0 "1 day of 10 -> 10"
  submitMustFail w.bob do exerciseCmd v1 YapVesting_Claim                      -- nothing new has vested
  locked1 <- lockedOf w w.bob
  assertMsg "the remainder is one locked holding of 90" ([ h.amount | (_, h) <- locked1 ] == [90.0])
  passTime (days 4)
  (_, Some v2) <- submit w.bob do exerciseCmd v1 YapVesting_Claim
  expectBalance (balance w w.bob) 50.0 "5 days of 10 -> 50 in total"
  passTime (days 6)                                                               -- past the end
  (_, rest) <- submit w.bob do exerciseCmd v2 YapVesting_Claim
  assertMsg "the schedule is finished" (rest == None)
  expectBalance (balance w w.bob) 100.0 "everything released"
  locked2 <- lockedOf w w.bob
  assertMsg "nothing stays locked" (null locked2)
  expectBalance (supplyAll w) 100.0 "supply unchanged by the claims"

testVestingRevoke : Script ()
testVestingRevoke = do
  w <- setup
  adm <- vestAdmin w
  now <- getTime
  v <- grantVest w adm w.bob now (seconds 0) (days 10) True
  passTime (days 4)
  submitMustFail w.bob do exerciseCmd v YapVesting_Revoke                      -- only the admin
  _ <- submit w.admin do exerciseCmd v YapVesting_Revoke
  expectBalance (balance w w.bob) 40.0 "the vested part stays with the beneficiary"
  expectBalance (balance w w.admin) 60.0 "the unvested part returns to the admin"
  vs <- query @YapVesting w.admin
  assertMsg "the schedule is gone" (null vs)
  locked <- lockedOf w w.bob
  assertMsg "nothing stays locked" (null locked)
  expectBalance (supplyAll w) 100.0 "supply unchanged"
  -- a grant that is not revocable cannot be revoked
  v2 <- grantVest w adm w.alice now (seconds 0) (days 10) False
  submitMustFail w.admin do exerciseCmd v2 YapVesting_Revoke

testVestingClosedAfterTheEnd : Script ()
testVestingClosedAfterTheEnd = do
  w <- setup
  adm <- vestAdmin w
  now <- getTime
  v <- grantVest w adm w.bob now (seconds 0) (days 10) True
  submitMustFail w.bob do exerciseCmd v YapVesting_Close                        -- not finished
  passTime (days 11)
  [(l, _)] <- lockedOf w w.bob
  sendOffer w w.bob w.alice 1.0 [l]                                               -- after the end the lock has expired: the holding is spendable
  submitMustFail w.bob do exerciseCmd v YapVesting_Claim                        -- ... so the schedule can no longer pay out
  submitMustFail w.alice do exerciseCmd v YapVesting_Close                      -- only the beneficiary
  _ <- submit w.bob do exerciseCmd v YapVesting_Close
  vs <- query @YapVesting w.admin
  assertMsg "the schedule is gone" (null vs)
  expectBalance (supplyAll w) 100.0 "supply unchanged"

testVestingGrantGuards : Script ()
testVestingGrantGuards = do
  w <- setup
  adm <- vestAdmin w
  now <- getTime
  let go amt st cl fin = submitMustFail w.admin do
        exerciseCmd adm YapAdmin_GrantVesting with
          beneficiary = w.bob
          amount = amt
          start = addRelTime now st
          cliff = addRelTime now cl
          finish = addRelTime now fin
          revocable = True
  go 0.0 (seconds 0) (seconds 0) (days 1)                -- zero
  go (-5.0) (seconds 0) (seconds 0) (days 1)             -- negative
  go 0.0000001 (seconds 0) (seconds 0) (days 1)          -- 7 decimals
  go 10.0 (days 1) (days 1) (days 1)                     -- finish = start
  go 10.0 (seconds 0) (seconds (-1)) (days 1)            -- cliff before start
  go 10.0 (seconds 0) (days 2) (days 1)                  -- cliff after the end
  go 10.0 (days (-3)) (days (-3)) (days (-1))            -- already over
  submitMustFail w.bob do                                  -- only the admin issues
    exerciseCmd adm YapAdmin_GrantVesting with
      beneficiary = w.bob
      amount = 10.0
      start = now
      cliff = now
      finish = addRelTime now (days 1)
      revocable = True
  expectBalance (supplyAll w) 0.0 "nothing was issued"

-- ---------------------------------------------------------------------------------------------------------
-- operator / governor split (0.7.0)

-- carol is the operator in these tests; the admin plays the governor
appoint : World -> Decimal -> RelTime -> Script (ContractId YapOperatorAuthority)
appoint w allowance validFor = do
  adm <- vestAdmin w
  now <- getTime
  submit w.admin do
    exerciseCmd adm YapAdmin_AppointOperator with operator = w.carol, allowance, validUntil = addRelTime now validFor

-- the (single) live authority and its allowance
opState : World -> Script (ContractId YapOperatorAuthority, Decimal)
opState w = do
  [(c, a)] <- query @YapOperatorAuthority w.admin
  pure (c, a.allowance)

opMint : World -> ContractId YapOperatorAuthority -> Party -> Decimal -> Commands (ContractId YapHolding, ContractId YapOperatorAuthority)
opMint w auth to amt = exerciseCmd auth YapOperator_Mint with recipient = to, amount = amt

testOperatorMintShrinksAllowance : Script ()
testOperatorMintShrinksAllowance = do
  w <- setup
  auth <- appoint w 100.0 (days 30)
  (_, auth2) <- submit w.carol do opMint w auth w.alice 40.0
  expectBalance (balance w w.alice) 40.0 "alice got 40"
  (_, a) <- opState w
  assertMsg ("allowance 60, got " <> show a) (a == 60.0)
  submitMustFail w.carol do opMint w auth w.alice 1.0          -- the old authority is consumed
  submitMustFail w.carol do opMint w auth2 w.alice 60.0000001  -- over the rest (and 7 decimals)
  submitMustFail w.carol do opMint w auth2 w.alice 60.01
  submitMustFail w.carol do opMint w auth2 w.alice 0.0000001   -- 7 decimals, well inside the allowance
  submitMustFail w.carol do opMint w auth2 w.alice 0.0
  submitMustFail w.carol do opMint w auth2 w.alice (-1.0)
  (_, auth3) <- submit w.carol do opMint w auth2 w.bob 60.0
  expectBalance (balance w w.bob) 60.0 "bob got the rest"
  submitMustFail w.carol do opMint w auth3 w.bob 0.000001      -- allowance is zero now
  expectBalance (supplyAll w) 100.0 "exactly the allowance was issued"

testOperatorExpires : Script ()
testOperatorExpires = do
  w <- setup
  auth <- appoint w 100.0 (days 1)
  now <- getTime
  passTime (days 2)
  submitMustFail w.carol do opMint w auth w.alice 1.0
  submitMustFail w.carol do
    exerciseCmd auth YapOperator_GrantVesting with
      beneficiary = w.bob, amount = 1.0, start = now, cliff = now, finish = addRelTime now (days 5), revocable = True
  submitMustFail w.carol do exerciseCmd auth YapOperator_CreatePreapproval with receiver = w.bob
  expectBalance (supplyAll w) 0.0 "nothing was issued"

testOperatorGrantVestingUsesAllowance : Script ()
testOperatorGrantVestingUsesAllowance = do
  w <- setup
  auth <- appoint w 100.0 (days 30)
  now <- getTime
  let grant a amt fin = exerciseCmd a YapOperator_GrantVesting with
        beneficiary = w.bob, amount = amt, start = now, cliff = now, finish = addRelTime now fin, revocable = True
  submitMustFail w.carol do grant auth 100.01 (days 5)
  submitMustFail w.carol do grant auth 0.0 (days 5)
  submitMustFail w.carol do grant auth 10.0 (seconds 0)       -- finish not in the future
  (_, auth2) <- submit w.carol do grant auth 70.0 (days 5)
  (_, a) <- opState w
  assertMsg ("allowance 30, got " <> show a) (a == 30.0)
  locked <- lockedOf w w.bob
  assertMsg "70 locked for bob" (sum [ h.amount | (_, h) <- locked ] == 70.0)
  submitMustFail w.carol do grant auth2 30.01 (days 5)
  expectBalance (supplyAll w) 70.0 "only the vested grant exists"

testOperatorPreapproval : Script ()
testOperatorPreapproval = do
  w <- setup
  auth <- appoint w 0.0 (days 30)
  _ <- submit w.carol do exerciseCmd auth YapOperator_CreatePreapproval with receiver = w.bob
  ps <- query @YapTransferPreapproval w.admin
  assertMsg "one preapproval for bob" (length [ () | (_, p) <- ps, p.receiver == w.bob, p.admin == w.admin ] == 1)
  -- the same authority still works after a non-consuming use
  _ <- submit w.carol do exerciseCmd auth YapOperator_CreatePreapproval with receiver = w.alice
  pure ()

testOperatorHasNoOtherPower : Script ()
testOperatorHasNoOtherPower = do
  w <- setup
  auth <- appoint w 100.0 (days 30)
  adm <- vestAdmin w
  now <- getTime
  h <- mint w w.alice 10.0
  v <- submit w.admin do
    exerciseCmd adm YapAdmin_GrantVesting with
      beneficiary = w.bob, amount = 5.0, start = now, cliff = now, finish = addRelTime now (days 5), revocable = True
  submitMustFail w.carol do archiveCmd auth                              -- cannot remove its own limits
  submitMustFail w.carol do exerciseCmd auth YapOperatorAuthority_SetAllowance with newAllowance = 1000000.0, newValidUntil = addRelTime now (days 999)
  submitMustFail w.carol do exerciseCmd adm YapAdmin_Mint with recipient = w.carol, amount = 1.0
  submitMustFail w.carol do exerciseCmd adm YapAdmin_CreatePreapproval with receiver = w.carol
  submitMustFail w.carol do exerciseCmd adm YapAdmin_AppointOperator with operator = w.carol, allowance = 1000000.0, validUntil = addRelTime now (days 999)
  submitMustFail w.carol do archiveCmd h                                 -- holdings are the governor's
  submitMustFail w.carol do exerciseCmd v YapVesting_Revoke
  submitMustFail w.alice do opMint w auth w.alice 1.0                    -- only the named operator
  submitMustFail w.bob do exerciseCmd auth YapOperator_CreatePreapproval with receiver = w.bob
  submitMustFail w.admin do opMint w auth w.alice 1.0                    -- not even the governor through the operator door
  expectBalance (balance w w.alice) 10.0 "alice unchanged"

testGovernorControlsTheOperator : Script ()
testGovernorControlsTheOperator = do
  w <- setup
  auth <- appoint w 10.0 (days 1)
  now <- getTime
  auth2 <- submit w.admin do
    exerciseCmd auth YapOperatorAuthority_SetAllowance with newAllowance = 25.0, newValidUntil = addRelTime now (days 10)
  (_, a) <- opState w
  assertMsg "topped up to 25" (a == 25.0)
  submitMustFail w.admin do exerciseCmd auth2 YapOperatorAuthority_SetAllowance with newAllowance = -1.0, newValidUntil = now
  submitMustFail w.admin do exerciseCmd auth2 YapOperatorAuthority_SetAllowance with newAllowance = 1.0000001, newValidUntil = now
  passTime (days 5)                                                      -- old expiry passed, new one not
  (_, auth3) <- submit w.carol do opMint w auth2 w.alice 5.0
  -- lowering takes effect at once
  auth4 <- submit w.admin do
    exerciseCmd auth3 YapOperatorAuthority_SetAllowance with newAllowance = 1.0, newValidUntil = addRelTime now (days 10)
  submitMustFail w.carol do opMint w auth4 w.alice 2.0
  -- revoking: the governor archives the delegation
  submit w.admin do archiveCmd auth4
  submitMustFail w.carol do opMint w auth4 w.alice 1.0
  expectBalance (supplyAll w) 5.0 "5 issued in total"

testAppointOperatorGuards : Script ()
testAppointOperatorGuards = do
  w <- setup
  adm <- vestAdmin w
  now <- getTime
  let go op al = submitMustFail w.admin do
        exerciseCmd adm YapAdmin_AppointOperator with operator = op, allowance = al, validUntil = addRelTime now (days 1)
  go w.admin 10.0                      -- operator = governor
  go w.carol (-1.0)
  go w.carol 0.0000001
  submitMustFail w.carol do            -- only the governor appoints
    exerciseCmd adm YapAdmin_AppointOperator with operator = w.carol, allowance = 1.0, validUntil = addRelTime now (days 1)
  os <- query @YapOperatorAuthority w.admin
  assertMsg "no authority was created" (null os)

-- fixed-supply vesting: funded from the admin's own holdings, nothing is minted
testVestingFromTreasury : Script ()
testVestingFromTreasury = do
  w <- setup
  adm <- vestAdmin w
  now <- getTime
  t <- mint w w.admin 500.0
  other <- mint w w.alice 50.0
  let grant who cids amt = submitMustFail who do
        exerciseCmd adm YapAdmin_GrantVestingFromTreasury with beneficiary = w.bob, amount = amt, start = now, cliff = now, finish = addRelTime now (days 10), revocable = True, treasuryCids = cids
  grant w.bob [t] 10.0                 -- only the admin
  grant w.admin [other] 10.0           -- an input that is not the admin's own
  grant w.admin [t] 500.01             -- more than the inputs hold
  grant w.admin [t] 0.0                -- zero
  grant w.admin [] 10.0                -- no inputs
  v <- submit w.admin do
    exerciseCmd adm YapAdmin_GrantVestingFromTreasury with beneficiary = w.bob, amount = 200.0, start = now, cliff = now, finish = addRelTime now (days 10), revocable = True, treasuryCids = [t]
  expectBalance (supplyAll w) 550.0 "supply unchanged: 500 treasury + 50"
  expectBalance (balance w w.admin) 300.0 "the treasury kept the change"
  locked <- lockedOf w w.bob
  assertMsg "bob has 200 locked" (sum [ h.amount | (_, h) <- locked ] == 200.0)
  passTime (days 5)
  _ <- submit w.admin do exerciseCmd v YapVesting_Revoke
  expectBalance (balance w w.bob) 100.0 "the vested half stays with bob"
  expectBalance (balance w w.admin) 400.0 "the unvested half returns to the treasury"
  expectBalance (supplyAll w) 550.0 "supply unchanged after the revoke"

-- ---------------------------------------------------------------------------------------------------------
-- Allocation V2: multi-leg, net amount, committed, batch settlement

settlementInfo : Party -> Text -> A2.SettlementInfo
settlementInfo executor sid = A2.SettlementInfo with executors = [executor], id = sid, cid = None, meta = M.emptyMetadata

legSide : Text -> A2.TransferSide -> Party -> Decimal -> A2.TransferLegSide
legSide lid side other amount = A2.TransferLegSide with
  transferLegId = lid, side, otherside = v2Account other, amount, instrumentId = "YAP", meta = M.emptyMetadata

transferLeg : Text -> Party -> Party -> Decimal -> A2.TransferLeg
transferLeg lid s r amount = A2.TransferLeg with
  transferLegId = lid, sender = v2Account s, receiver = v2Account r, amount, instrumentId = "YAP", meta = M.emptyMetadata

specV2 : World -> Party -> [A2.TransferLegSide] -> Optional Time -> Bool -> A2.AllocationSpecification
specV2 w owner sides deadline committed = A2.AllocationSpecification with
  admin = w.admin, authorizer = v2Account owner, transferLegSides = sides, settlementDeadline = deadline
  nextIterationFunding = None, committed, meta = M.emptyMetadata

allocateV2Cmd : World -> Time -> [Party] -> A2.SettlementInfo -> A2.AllocationSpecification -> [ContractId YapHolding] -> Commands AI2.AllocationInstructionResult
allocateV2Cmd w now actors settlement spec inputs =
  exerciseCmd (toInterfaceContractId @AI2.AllocationFactory w.af) AI2.AllocationFactory_Allocate with
    settlement
    allocation = spec
    requestedAt = now
    inputHoldingCids = map toInterfaceContractId inputs
    extraArgs = noExtra
    actors

doAllocV2 : World -> Party -> A2.SettlementInfo -> [A2.TransferLegSide] -> Optional Time -> Bool -> [ContractId YapHolding] -> Script (ContractId A2.Allocation)
doAllocV2 w owner settlement sides deadline committed inputs = do
  now <- getTime
  r <- submit (actAs owner <> disclose w.afD) (allocateV2Cmd w now [owner] settlement (specV2 w owner sides deadline committed) inputs)
  case r.output of
    AI2.AllocationInstructionResult_Completed c -> pure c
    _ -> abort "expected a completed allocation"

settleBatchCmd : ContractId YapSettlementFactory -> A2.SettlementInfo -> [A2.TransferLeg] -> [A2.FinalizedAllocation] -> [Party] -> Commands A2.SettlementFactory_SettleBatchResult
settleBatchCmd sf settlement legs allocs actors =
  exerciseCmd (toInterfaceContractId @A2.SettlementFactory sf) A2.SettlementFactory_SettleBatch with
    settlement, transferLegs = legs, allocations = allocs, actors, extraArgs = noExtra

fin : ContractId A2.Allocation -> A2.FinalizedAllocation
fin c = A2.FinalizedAllocation with allocationCid = c, extraTransferLegSides = [], nextIterationFunding = None

settleV2 : ContractId A2.Allocation -> [Party] -> Commands A2.AllocationResult
settleV2 c actors = exerciseCmd c A2.Allocation_Settle with actors, extraTransferLegSides = [], nextIterationFunding = None, extraArgs = noExtra

cancelV2 : ContractId A2.Allocation -> [Party] -> Commands A2.AllocationResult
cancelV2 c actors = exerciseCmd c A2.Allocation_Cancel with actors, extraArgs = noExtra

withdrawAllocV2 : ContractId A2.Allocation -> [Party] -> Commands A2.AllocationResult
withdrawAllocV2 c actors = exerciseCmd c A2.Allocation_Withdraw with actors, extraArgs = noExtra

-- alice pays 10 to bob (leg L1), bob pays 3 to alice (leg L2): alice's NET outflow is 7
testV2NetSettlement : Script ()
testV2NetSettlement = do
  w <- setup
  now <- getTime
  ha <- mint w w.alice 100.0
  hb <- mint w w.bob 50.0
  sf <- submit w.admin do createCmd YapSettlementFactory with admin = w.admin
  Some sfD <- queryDisclosure w.admin sf
  let si = settlementInfo w.carol "dvp-1"
  let deadline = Some (addRelTime now (days 1))
  let legs = [transferLeg "L1" w.alice w.bob 10.0, transferLeg "L2" w.bob w.alice 3.0]
  aliceAlloc <- doAllocV2 w w.alice si [legSide "L1" A2.SenderSide w.bob 10.0, legSide "L2" A2.ReceiverSide w.bob 3.0] deadline False [ha]
  expectBalance (balance w w.alice) 93.0 "only the NET outflow (7) is locked, the rest is change"
  locked <- lockedOf w w.alice
  assertMsg "exactly 7 locked for alice" (sum [ h.amount | (_, h) <- locked ] == 7.0)
  -- bob receives more than he sends: nothing to lock, his holding is untouched
  bobAlloc <- doAllocV2 w w.bob si [legSide "L1" A2.ReceiverSide w.alice 10.0, legSide "L2" A2.SenderSide w.alice 3.0] deadline False [hb]
  expectBalance (balance w w.bob) 50.0 "bob locked nothing"
  expectBalance (supplyAll w) 150.0 "locked funds are still supply"
  -- views show what wallets need
  -- alice sees BOTH allocations (she is the counterparty of bob's); hers is the one with a backing holding
  views <- queryInterface @A2.Allocation w.alice
  assertMsg "alice sees both allocations" (length views == 2)
  assertMsg "alice's allocation shows one backing holding, the deadline and the available actions" (case [ v | (c, Some v) <- views, c == aliceAlloc ] of
    [v] -> length v.holdingCids == 1 && v.expiresAt == deadline && v.numIterations == 0 && Map.member A2.AA_Withdraw v.availableActions
    _ -> False)
  assertMsg "bob's allocation has no backing holding (nothing to lock)" (case [ v | (c, Some v) <- views, c == bobAlloc ] of
    [v] -> null v.holdingCids
    _ -> False)
  -- only the executor (with the factory disclosed) settles
  submitMustFail (actAs w.alice <> disclose sfD) (settleBatchCmd sf si legs [fin aliceAlloc, fin bobAlloc] [w.alice])
  _ <- submit (actAs w.carol <> disclose sfD) (settleBatchCmd sf si legs [fin aliceAlloc, fin bobAlloc] [w.carol])
  expectBalance (balance w w.alice) 93.0 "alice paid 10, got 3 (net 7 left her account)"
  expectBalance (balance w w.bob) 57.0 "bob got 10, paid 3 (net 7 came in)"
  expectBalance (supplyAll w) 150.0 "supply unchanged by the settlement"
  stillLocked <- lockedOf w w.alice
  assertMsg "nothing stays locked" (null stillLocked)
  rest <- query @YapAllocationV2 w.admin
  assertMsg "both allocations are consumed" (null rest)

testV2SettleBatchGuards : Script ()
testV2SettleBatchGuards = do
  w <- setup
  now <- getTime
  ha <- mint w w.alice 100.0
  hb <- mint w w.bob 50.0
  sf <- submit w.admin do createCmd YapSettlementFactory with admin = w.admin
  Some sfD <- queryDisclosure w.admin sf
  let si = settlementInfo w.carol "dvp-2"
  let deadline = Some (addRelTime now (days 1))
  let legs = [transferLeg "L1" w.alice w.bob 10.0]
  a <- doAllocV2 w w.alice si [legSide "L1" A2.SenderSide w.bob 10.0] deadline False [ha]
  b <- doAllocV2 w w.bob si [legSide "L1" A2.ReceiverSide w.alice 10.0] deadline False [hb]
  let run ls fs ac = submitMustFail (actAs w.carol <> disclose sfD) (settleBatchCmd sf si ls fs ac)
  run [transferLeg "L1" w.alice w.bob 11.0] [fin a, fin b] [w.carol]                    -- amount differs from the authorizations
  run [] [fin a, fin b] [w.carol]                                                         -- no legs
  run [transferLeg "L1" w.alice w.bob 10.0, transferLeg "L9" w.bob w.alice 1.0] [fin a, fin b] [w.carol]   -- a leg nobody authorized
  run legs [fin a] [w.carol]                                                              -- the receiver side is missing
  run legs [fin a, fin b, fin b] [w.carol]                                                -- the same allocation twice
  run [transferLeg "L1" w.bob w.alice 10.0] [fin a, fin b] [w.carol]                    -- direction reversed
  run [transferLeg "X1" w.alice w.bob 10.0] [fin a, fin b] [w.carol]                    -- another leg id
  submitMustFail (actAs w.carol <> disclose sfD) (settleBatchCmd sf (settlementInfo w.carol "other") legs [fin a, fin b] [w.carol])   -- another settlement
  submitMustFail (actAs w.carol <> disclose sfD) (settleBatchCmd sf si legs [((fin a) with extraTransferLegSides = [legSide "L2" A2.SenderSide w.bob 1.0]), fin b] [w.carol])
  expectBalance (supplyAll w) 150.0 "nothing moved by the failed attempts"
  -- the right one works
  _ <- submit (actAs w.carol <> disclose sfD) (settleBatchCmd sf si legs [fin a, fin b] [w.carol])
  expectBalance (balance w w.bob) 60.0 "bob got the 10"
  expectBalance (supplyAll w) 150.0 "supply unchanged"

testV2DirectSettleNeedsAdminAndExecutors : Script ()
testV2DirectSettleNeedsAdminAndExecutors = do
  w <- setup
  now <- getTime
  ha <- mint w w.alice 20.0
  let si = settlementInfo w.carol "dvp-3"
  a <- doAllocV2 w w.alice si [legSide "L1" A2.SenderSide w.bob 5.0] (Some (addRelTime now (days 1))) False [ha]
  submitMustFail w.carol (settleV2 a [w.carol])                  -- the admin is missing
  submitMustFail w.alice (settleV2 a [w.alice])                  -- not the executor
  submitMustFail w.admin (settleV2 a [w.admin])                  -- the executor is missing
  -- even with the admin and the executor together, iterated settlement is refused (both the extra legs and the next-iteration funding)
  submitMustFail (actAs [w.admin, w.carol]) do
    exerciseCmd a A2.Allocation_Settle with
      actors = [w.admin, w.carol]
      extraTransferLegSides = [legSide "L2" A2.SenderSide w.bob 1.0]
      nextIterationFunding = None
      extraArgs = noExtra
  submitMustFail (actAs [w.admin, w.carol]) do
    exerciseCmd a A2.Allocation_Settle with
      actors = [w.admin, w.carol]
      extraTransferLegSides = []
      nextIterationFunding = Some TextMap.empty
      extraArgs = noExtra

testV2NonCommittedWithdraw : Script ()
testV2NonCommittedWithdraw = do
  w <- setup
  now <- getTime
  ha <- mint w w.alice 20.0
  let si = settlementInfo w.carol "wd-1"
  a <- doAllocV2 w w.alice si [legSide "L1" A2.SenderSide w.bob 5.0] (Some (addRelTime now (days 1))) False [ha]
  submitMustFail w.bob (withdrawAllocV2 a [w.bob])                    -- only the authorizer
  submitMustFail w.carol (withdrawAllocV2 a [w.carol])
  _ <- submit w.alice (withdrawAllocV2 a [w.alice])
  expectBalance (balance w w.alice) 20.0 "funds released at once"
  locked <- lockedOf w w.alice
  assertMsg "nothing locked any more" (null locked)
  rest <- query @YapAllocationV2 w.admin
  assertMsg "allocation consumed" (null rest)

testV2CommittedAllocation : Script ()
testV2CommittedAllocation = do
  w <- setup
  now <- getTime
  ha <- mint w w.alice 20.0
  let si = settlementInfo w.carol "commit-1"
  let deadline = addRelTime now (days 1)
  a <- doAllocV2 w w.alice si [legSide "L1" A2.SenderSide w.bob 5.0] (Some deadline) True [ha]
  submitMustFail w.alice (withdrawAllocV2 a [w.alice])                -- committed: no withdrawal before the deadline
  submitMustFail w.bob (cancelV2 a [w.bob])                      -- cancel: executors only
  submitMustFail (actAs [w.admin, w.alice]) (cancelV2 a [w.admin, w.alice])   -- the admin only after the deadline
  _ <- submit w.carol (cancelV2 a [w.carol])                     -- the executor can always release it
  expectBalance (balance w w.alice) 20.0 "cancel released the funds"
  -- a second committed allocation: after the deadline the settlement is closed and the owner can withdraw
  hs2 <- freeOf w w.alice
  a2 <- doAllocV2 w w.alice si [legSide "L1" A2.SenderSide w.bob 5.0] (Some (addRelTime now (days 2))) True (map fst hs2)
  passTime (days 3)
  submitMustFail w.carol (settleV2 a2 [w.admin, w.carol])
  _ <- submit w.alice (withdrawAllocV2 a2 [w.alice])
  expectBalance (balance w w.alice) 20.0 "withdrawn after the deadline"

testV2ExpiredAllocationCanBeDiscarded : Script ()
testV2ExpiredAllocationCanBeDiscarded = do
  w <- setup
  now <- getTime
  ha <- mint w w.alice 20.0
  let si = settlementInfo w.carol "disc-1"
  a <- doAllocV2 w w.alice si [legSide "L1" A2.SenderSide w.bob 5.0] (Some (addRelTime now (hours 2))) False [ha]
  let aV2 = fromInterfaceContractId @YapAllocationV2 a
  submitMustFail w.alice do exerciseCmd aV2 YapAllocationV2_DiscardExpired          -- not expired yet
  passTime (hours 3)
  -- the lock has expired, so the owner may have spent the locked funds: the allocation can still be dropped
  [(l, _)] <- lockedOf w w.alice
  _ <- submit w.alice do exerciseCmd l YapHolding_Burn
  submitMustFail w.alice (withdrawAllocV2 a [w.alice])                -- the backing holding is gone
  submit w.alice do exerciseCmd aV2 YapAllocationV2_DiscardExpired
  rest <- query @YapAllocationV2 w.admin
  assertMsg "allocation dropped" (null rest)

testV2AllocationGuards : Script ()
testV2AllocationGuards = do
  w <- setup
  now <- getTime
  ha <- mint w w.alice 100.0
  let si = settlementInfo w.carol "g-1"
  let deadline = Some (addRelTime now (days 1))
  let ok1 = [legSide "L1" A2.SenderSide w.bob 10.0]
  let tryIt actors settlement spec = submitMustFail (actAs w.alice <> disclose w.afD) (allocateV2Cmd w now actors settlement spec [ha])
  tryIt [w.alice] si ((specV2 w w.alice ok1 deadline False) with admin = w.bob)                     -- wrong admin
  tryIt [w.alice] si (specV2 w w.alice [((legSide "L1" A2.SenderSide w.bob 10.0) with instrumentId = "OTHER")] deadline False)
  tryIt [w.alice] si (specV2 w w.alice [legSide "L1" A2.SenderSide w.bob 0.0] deadline False)       -- zero
  tryIt [w.alice] si (specV2 w w.alice [legSide "L1" A2.SenderSide w.bob 0.0000001] deadline False) -- 7 decimals
  tryIt [w.alice] si (specV2 w w.alice [legSide "L1" A2.SenderSide w.bob 1.0, legSide "L1" A2.SenderSide w.carol 1.0] deadline False)  -- duplicate leg id
  tryIt [w.alice] si (specV2 w w.alice ok1 (Some (addRelTime now (seconds (-5)))) False)            -- deadline in the past
  tryIt [w.alice] si (specV2 w w.alice ok1 None True)                                               -- committed without a deadline
  tryIt [w.alice] si ((specV2 w w.alice ok1 deadline False) with nextIterationFunding = Some TextMap.empty)   -- iterated settlement
  tryIt [w.alice] si (specV2 w w.alice [] deadline False)                                           -- no legs
  tryIt [w.alice] si (specV2 w w.alice [legSide "L1" A2.SenderSide w.alice 5.0] deadline False)      -- to herself
  tryIt [w.alice] si ((specV2 w w.alice ok1 deadline False) with authorizer = ((v2Account w.alice) with provider = Some w.admin))   -- not a plain account
  tryIt [w.alice] (si with executors = []) (specV2 w w.alice ok1 deadline False)                    -- no executor
  tryIt [w.bob] si (specV2 w w.alice ok1 deadline False)                                            -- the authorizer is not among the actors
  tryIt [w.alice] si (specV2 w w.alice [legSide "L1" A2.SenderSide w.bob 101.0] deadline False)     -- more than the inputs hold
  expectBalance (balance w w.alice) 100.0 "nothing moved"
  -- and a plain one goes through
  r <- submit (actAs w.alice <> disclose w.afD) (allocateV2Cmd w now [w.alice] si (specV2 w w.alice ok1 deadline False) [ha])
  assertMsg "completed" (case r.output of
    AI2.AllocationInstructionResult_Completed _ -> True
    _ -> False)
  assertMsg "change returned in the result" (not (TextMap.null r.authorizerChangeCids))

-- closes two gaps that mutation testing would otherwise report: the deadline in a batch settlement, and an allocation of another admin
testV2BatchRefusesAfterTheDeadline : Script ()
testV2BatchRefusesAfterTheDeadline = do
  w <- setup
  now <- getTime
  ha <- mint w w.alice 20.0
  hb <- mint w w.bob 20.0
  sf <- submit w.admin do createCmd YapSettlementFactory with admin = w.admin
  Some sfD <- queryDisclosure w.admin sf
  let si = settlementInfo w.carol "late-1"
  let legs = [transferLeg "L1" w.alice w.bob 5.0]
  a <- doAllocV2 w w.alice si [legSide "L1" A2.SenderSide w.bob 5.0] (Some (addRelTime now (hours 1))) False [ha]
  b <- doAllocV2 w w.bob si [legSide "L1" A2.ReceiverSide w.alice 5.0] (Some (addRelTime now (hours 1))) False [hb]
  passTime (hours 2)
  submitMustFail (actAs w.carol <> disclose sfD) (settleBatchCmd sf si legs [fin a, fin b] [w.carol])
  expectBalance (supplyAll w) 40.0 "nothing moved"
  -- the same settlement inside its window works (the test is not vacuous)
  now2 <- getTime
  [(ha2, _)] <- freeOf w w.alice
  let si2 = settlementInfo w.carol "late-2"
  a2 <- doAllocV2 w w.alice si2 [legSide "L1" A2.SenderSide w.bob 5.0] (Some (addRelTime now2 (days 1))) False [ha2]
  b2 <- doAllocV2 w w.bob si2 [legSide "L1" A2.ReceiverSide w.alice 5.0] (Some (addRelTime now2 (days 1))) False []
  _ <- submit (actAs w.carol <> disclose sfD) (settleBatchCmd sf si2 legs [fin a2, fin b2] [w.carol])
  expectBalance (balance w w.bob) 25.0 "bob got the 5 inside the window (20 + 5)"

testV2BatchRefusesAllocationsOfAnotherAdmin : Script ()
testV2BatchRefusesAllocationsOfAnotherAdmin = do
  w <- setup
  other <- allocateParty "other"
  now <- getTime
  hb <- mint w w.bob 20.0
  sf <- submit w.admin do createCmd YapSettlementFactory with admin = w.admin
  Some sfD <- queryDisclosure w.admin sf
  let si = settlementInfo w.carol "foreign-1"
  let deadline = Some (addRelTime now (days 1))
  b <- doAllocV2 w w.bob si [legSide "L1" A2.SenderSide w.alice 5.0] deadline False [hb]
  -- an allocation that covers the other side of the leg, but for ANOTHER admin's token
  let foreignSpec = (specV2 w w.alice [legSide "L1" A2.ReceiverSide w.bob 5.0] deadline False) with admin = other
  f <- submit (actAs [other, w.alice]) do
    createCmd YapAllocationV2 with admin = other, owner = w.alice, settlement = si, spec = foreignSpec, lockedCids = [], createdAt = now
  let fa = toInterfaceContractId @A2.Allocation f
  submitMustFail (actAs w.carol <> disclose sfD) (settleBatchCmd sf si [transferLeg "L1" w.bob w.alice 5.0] [fin b, fin fa] [w.carol])
  expectBalance (supplyAll w) 20.0 "nothing moved"
