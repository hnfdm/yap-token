#!/usr/bin/env bash
# Rebuilds the cUSDT DAR (v@@VERSION@@) on the testnet VPS and updates the registry.
# Save as a file, then:  bash update-on-vps.sh
set -euo pipefail
export PATH="$HOME/.dpm/bin:$PATH"
P=$HOME/cusdt-token/daml/cusdt-token
cd $P
mkdir -p dars

for n in allocation allocation-instruction; do
  f=splice-api-token-$n-v1-1.0.0.dar
  [ -s dars/$f ] || curl -fsSL -o dars/$f https://raw.githubusercontent.com/hyperledger-labs/splice/main/daml/dars/$f
done
ls dars

cat > daml.yaml <<'EOF_YAML'
@@EMBED daml/cusdt-token/daml.yaml@@
EOF_YAML

cat > daml/CusdtToken.daml <<'EOF_DAML'
@@EMBED daml/cusdt-token/daml/CusdtToken.daml@@
EOF_DAML

echo "== build =="
dpm install package
dpm build
DAR=.daml/dist/cusdt-token-@@VERSION@@.dar
ls -la $DAR
sha256sum $DAR

echo "== registry =="
cat > /opt/cusdt-registry/server.mjs <<'EOF_JS'
@@EMBED registry/src/server.mjs@@
EOF_JS
systemctl restart cusdt-registry
sleep 3
curl -s localhost:8787/health; echo
echo
echo "DAR: $P/$DAR"
