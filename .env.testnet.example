# Copy to .env.testnet (gitignored) and fill in. Testnet validator: see memory xxx-testnet-parties.
LEDGER_URL=https://ledger-testnet.xxx.xyz
KC_TOKEN_URL=https://auth-testnet.xxx.xyz/realms/canton/protocol/openid-connect/token
KC_CLIENT_ID=
KC_CLIENT_SECRET=
KC_SCOPE=daml_ledger_api
# Ledger API user that will be granted CanActAs/CanReadAs on cusdt-admin
LEDGER_USER_ID=
CUSDT_ADMIN_HINT=cusdt-admin
# Filled in after scripts/2-setup.mjs
CUSDT_ADMIN_PARTY=
CUSDT_PACKAGE_NAME=#cusdt-token
CUSDT_REGISTRY_URL=http://localhost:8787
# Set to 1 only if the fake-domain endpoint has a self-signed cert
INSECURE_TLS=0
