-- YAP governance actions for a multi-owner (decentralized) admin party.
--
-- The YAP admin ("governor") can be a Canton decentralized party managed with the Decentralization Manager (DecMan): no single node can
-- act as it. The only way to use its authority is a governed action: a member creates one of the proposal contracts below (signatory =
-- the member, observer = the governance party), enough members confirm it, and GovernanceRules executes it, which calls `executeImpl`
-- with the authority of the governance party.
--
-- Every proposal names the contract it acts on (a ContractId), so it is only valid while that contract is still the live one: a stale
-- id makes the execution fail and nothing changes (propose again with the current id). Every proposal also checks that the target
-- belongs to the governance party, so a proposal cannot be used on another issuer's contracts.
--
-- The day-to-day power stays with the operator (see YapOperatorAuthority); these are the rare, governed decisions.
module YapGovernance where

import DA.Foldable (forA_)
import DA.TextMap qualified as TextMap
import YapToken
import Governance.Action
import Splice.Api.Token.BurnMintV1 qualified as BM
import Splice.Api.Token.HoldingV1 qualified as H
import Splice.Api.Token.MetadataV1 qualified as M
import Splice.Api.Token.TransferInstructionV1 qualified as TI

-- Appoint an operator (or add one more authority for an operator that already has one, e.g. a top-up or a second lane).
template AppointOperatorProposal
  with
    governanceParty : Party
    proposer        : Party
    adminCid        : ContractId YapAdmin
    operator        : Party
    allowance       : Decimal
    validUntil      : Time
  where
    signatory proposer
    observer governanceParty
    ensure allowance >= 0.0 && operator /= governanceParty

    interface instance GovernableAction for AppointOperatorProposal where
      view = GovernableActionView with
        governanceParty
        proposer
        actionLabel = "YapAppointOperator"
        description = "Appoint YAP operator " <> show operator <> " with allowance " <> show allowance <> " until " <> show validUntil
      executeImpl = do
        a <- fetch adminCid
        assertMsg "the YapAdmin contract belongs to another party" (a.admin == governanceParty)
        _ <- exercise adminCid YapAdmin_AppointOperator with operator, allowance, validUntil
        pure ()

-- Change the allowance and expiry of an existing operator authority (up or down).
template SetOperatorAllowanceProposal
  with
    governanceParty : Party
    proposer        : Party
    authorityCid    : ContractId YapOperatorAuthority
    newAllowance    : Decimal
    newValidUntil   : Time
  where
    signatory proposer
    observer governanceParty
    ensure newAllowance >= 0.0

    interface instance GovernableAction for SetOperatorAllowanceProposal where
      view = GovernableActionView with
        governanceParty
        proposer
        actionLabel = "YapSetOperatorAllowance"
        description = "Set YAP operator allowance to " <> show newAllowance <> " until " <> show newValidUntil
      executeImpl = do
        a <- fetch authorityCid
        assertMsg "the operator authority belongs to another party" (a.admin == governanceParty)
        _ <- exercise authorityCid YapOperatorAuthority_SetAllowance with newAllowance, newValidUntil
        pure ()

-- Revoke an operator authority (archive it). The operator can do nothing with it afterwards.
template RevokeOperatorProposal
  with
    governanceParty : Party
    proposer        : Party
    authorityCid    : ContractId YapOperatorAuthority
  where
    signatory proposer
    observer governanceParty

    interface instance GovernableAction for RevokeOperatorProposal where
      view = GovernableActionView with
        governanceParty
        proposer
        actionLabel = "YapRevokeOperator"
        description = "Revoke a YAP operator authority"
      executeImpl = do
        a <- fetch authorityCid
        assertMsg "the operator authority belongs to another party" (a.admin == governanceParty)
        archive authorityCid

-- Revoke a (revocable) vesting grant: the vested part goes to the beneficiary, the rest back to the governance party.
template RevokeVestingProposal
  with
    governanceParty : Party
    proposer        : Party
    vestingCid      : ContractId YapVesting
  where
    signatory proposer
    observer governanceParty

    interface instance GovernableAction for RevokeVestingProposal where
      view = GovernableActionView with
        governanceParty
        proposer
        actionLabel = "YapRevokeVesting"
        description = "Revoke a YAP vesting grant"
      executeImpl = do
        v <- fetch vestingCid
        assertMsg "the vesting belongs to another party" (v.admin == governanceParty)
        _ <- exercise vestingCid YapVesting_Revoke
        pure ()

-- Governor-direct mint (the operator normally mints within its allowance; this is for a decision that bypasses it).
template GovernorMintProposal
  with
    governanceParty : Party
    proposer        : Party
    adminCid        : ContractId YapAdmin
    recipient       : Party
    amount          : Decimal
  where
    signatory proposer
    observer governanceParty
    ensure amount > 0.0

    interface instance GovernableAction for GovernorMintProposal where
      view = GovernableActionView with
        governanceParty
        proposer
        actionLabel = "YapGovernorMint"
        description = "Mint " <> show amount <> " YAP for " <> show recipient
      executeImpl = do
        a <- fetch adminCid
        assertMsg "the YapAdmin contract belongs to another party" (a.admin == governanceParty)
        _ <- exercise adminCid YapAdmin_Mint with recipient, amount
        pure ()

-- Rescue: remove one holding from the ledger (the governance party is its signatory). This is the issuer's "admin can archive anything"
-- power, now behind the members' threshold. The reason is kept in the audit record.
template RescueHoldingProposal
  with
    governanceParty : Party
    proposer        : Party
    holdingCid      : ContractId YapHolding
    reason          : Text
  where
    signatory proposer
    observer governanceParty
    ensure reason /= ""

    interface instance GovernableAction for RescueHoldingProposal where
      view = GovernableActionView with
        governanceParty
        proposer
        actionLabel = "YapRescueHolding"
        description = "Archive a YAP holding. Reason: " <> reason
      executeImpl = do
        h <- fetch holdingCid
        assertMsg "the holding belongs to another issuer" (h.admin == governanceParty)
        archive holdingCid

-- Burn tokens that the governance party OWNS (its treasury). The BurnMint factory requires the owner of every burnt holding to be an
-- actor, so a governed burn can only touch holdings owned by the governance party itself. To retire tokens held by someone else, that
-- holder first sends them to the governance party (an operator-made preapproval makes that a direct transfer), then this runs.
template BurnTreasuryProposal
  with
    governanceParty : Party
    proposer        : Party
    factoryCid      : ContractId YapBurnMintFactory
    holdingCids     : [ContractId YapHolding]
  where
    signatory proposer
    observer governanceParty
    ensure not (null holdingCids)

    interface instance GovernableAction for BurnTreasuryProposal where
      view = GovernableActionView with
        governanceParty
        proposer
        actionLabel = "YapBurnTreasury"
        description = "Burn " <> show (length holdingCids) <> " YAP treasury holding(s) owned by the governance party"
      executeImpl = do
        f <- fetch factoryCid
        assertMsg "the BurnMint factory belongs to another party" (f.admin == governanceParty)
        hs <- forA holdingCids fetch
        forA_ hs $ \h -> do
          assertMsg "only holdings of the governance party's own issuance can be burnt" (h.admin == governanceParty)
          assertMsg "only holdings OWNED by the governance party can be burnt this way" (h.owner == governanceParty)
        _ <- exercise (toInterfaceContractId @BM.BurnMintFactory factoryCid) BM.BurnMintFactory_BurnMint with
          expectedAdmin = governanceParty
          instrumentId = yapInstrumentId governanceParty
          inputHoldingCids = map (toInterfaceContractId @H.Holding) holdingCids
          outputs = []
          extraActors = [governanceParty]
          extraArgs = M.ExtraArgs with
            context = M.ChoiceContext with values = TextMap.empty
            meta = M.emptyMetadata
        pure ()

-- Fixed-supply vesting grant: funded from the governance party's own treasury holdings (no new tokens are created).
template GrantVestingFromTreasuryProposal
  with
    governanceParty : Party
    proposer        : Party
    adminCid        : ContractId YapAdmin
    treasuryCids    : [ContractId YapHolding]
    beneficiary     : Party
    amount          : Decimal
    start           : Time
    cliff           : Time
    finish          : Time
    revocable       : Bool
  where
    signatory proposer
    observer governanceParty
    ensure amount > 0.0 && not (null treasuryCids)

    interface instance GovernableAction for GrantVestingFromTreasuryProposal where
      view = GovernableActionView with
        governanceParty
        proposer
        actionLabel = "YapGrantVestingFromTreasury"
        description = "Grant " <> show amount <> " YAP from the treasury to " <> show beneficiary <> ", vesting until " <> show finish <> (if revocable then " (revocable)" else " (not revocable)")
      executeImpl = do
        a <- fetch adminCid
        assertMsg "the YAP admin contract belongs to another party" (a.admin == governanceParty)
        _ <- exercise adminCid YapAdmin_GrantVestingFromTreasury with beneficiary, amount, start, cliff, finish, revocable, treasuryCids
        pure ()

-- Send tokens from the governance party's treasury to someone (an OFFER: the receiver accepts it, as with any transfer). With a fixed
-- supply this is how the treasury is distributed. The sender is the governance party, so this is only possible as a governed action.
template TreasuryTransferProposal
  with
    governanceParty : Party
    proposer        : Party
    factoryCid      : ContractId YapTransferFactory
    receiver        : Party
    amount          : Decimal
    treasuryCids    : [ContractId YapHolding]
    executeBefore   : Time
  where
    signatory proposer
    observer governanceParty
    ensure amount > 0.0 && not (null treasuryCids) && receiver /= governanceParty

    interface instance GovernableAction for TreasuryTransferProposal where
      view = GovernableActionView with
        governanceParty
        proposer
        actionLabel = "YapTreasuryTransfer"
        description = "Send " <> show amount <> " YAP from the treasury to " <> show receiver
      executeImpl = do
        f <- fetch factoryCid
        assertMsg "the transfer factory belongs to another party" (f.admin == governanceParty)
        now <- getTime
        _ <- exercise (toInterfaceContractId @TI.TransferFactory factoryCid) TI.TransferFactory_Transfer with
          expectedAdmin = governanceParty
          transfer = TI.Transfer with
            sender = governanceParty
            receiver
            amount
            instrumentId = yapInstrumentId governanceParty
            requestedAt = now
            executeBefore
            inputHoldingCids = map (toInterfaceContractId @H.Holding) treasuryCids
            meta = M.emptyMetadata
          extraArgs = M.ExtraArgs with
            context = M.ChoiceContext with values = TextMap.empty
            meta = M.emptyMetadata
        pure ()

-- Allocation of the treasury in ONE governed decision (e.g. the tokenomics schedule): a list of immediate releases (TGE shares) and
-- vesting grants, all paid out of the governance party's own treasury holdings, in order. The change of every step feeds the next one,
-- so no input is used twice, and the whole thing is atomic (if any item fails, nothing happens). No tokens are created: the supply is
-- unchanged. A release gives the receiver a normal holding at once (the governance party issues it itself, no accept step), a vest item
-- creates the locked holding + schedule exactly like YapAdmin_GrantVesting.
data AllocationItem
  = ReleaseItem with
      receiver    : Party
      amount      : Decimal
  | VestItem with
      beneficiary : Party
      amount      : Decimal
      start       : Time
      cliff       : Time
      finish      : Time
      revocable   : Bool
  deriving (Eq, Show)

itemAmount : AllocationItem -> Decimal
itemAmount (ReleaseItem _ a) = a
itemAmount (VestItem _ a _ _ _ _) = a

validItem : Party -> AllocationItem -> Bool
validItem gov (ReleaseItem r a) = a > 0.0 && r /= gov
validItem gov (VestItem b a s c f _) = a > 0.0 && b /= gov && s < f && s <= c && c <= f

-- Pays the items out one after the other; the change of each step is the input of the next one.
payOut : Party -> [ContractId YapHolding] -> [AllocationItem] -> Update [ContractId YapHolding]
payOut _ cur [] = pure cur
payOut gov cur (item :: rest) = do
  change <- case item of
    ReleaseItem receiver amount -> do
      assertPrecision "release amount" amount
      c <- spendInputsT gov gov amount cur
      _ <- create YapHolding with admin = gov, owner = receiver, amount, lock = None
      pure c
    VestItem beneficiary amount start cliff finish revocable -> do
      c <- spendInputsT gov gov amount cur
      _ <- grantVesting gov beneficiary amount start cliff finish revocable
      pure c
  payOut gov change rest

template AllocationProposal
  with
    governanceParty : Party
    proposer        : Party
    treasuryCids    : [ContractId YapHolding]
    items           : [AllocationItem]
    purpose         : Text
  where
    signatory proposer
    observer governanceParty
    ensure not (null treasuryCids) && not (null items) && purpose /= "" && all (validItem governanceParty) items

    interface instance GovernableAction for AllocationProposal where
      view = GovernableActionView with
        governanceParty
        proposer
        actionLabel = "YapAllocate"
        description = purpose <> ": " <> show (sum (map itemAmount items)) <> " YAP in " <> show (length items) <> " item(s)"
      executeImpl = do
        _ <- payOut governanceParty treasuryCids items
        pure ()
