-- cUSDT: CIP-56 (Canton Token Standard) token.
--
-- Implements Holding + TransferFactory + TransferInstruction. Token metadata is
-- off-ledger (see /registry in this repo). Allocation / settlement is NOT implemented yet.
module CusdtToken where

import DA.Foldable (forA_)
import DA.Time (subTime, convertRelTimeToMicroseconds)
import DA.Map qualified as Map
import DA.Text qualified as Text
import DA.TextMap qualified as TextMap
import Splice.Api.Token.AllocationInstructionV1 qualified as AI
import Splice.Api.Token.AllocationV1 qualified as A
import Splice.Api.Token.BurnMintV1 qualified as BM
import Splice.Api.Token.HoldingV1 qualified as H
import Splice.Api.Token.HoldingV2 qualified as H2
import Splice.Api.Token.MetadataV1 qualified as M
import Splice.Api.Token.TransferInstructionV1 qualified as TI
import Splice.Api.Token.TransferInstructionV2 qualified as TI2

cusdtSymbol : Text
cusdtSymbol = "cUSDT"

cusdtInstrumentId : Party -> H.InstrumentId
cusdtInstrumentId admin = H.InstrumentId with admin = admin, id = cusdtSymbol

-- Key under which the registry passes the receiver's preapproval cid in the choice context.
preapprovalKey : Text
preapprovalKey = "cusdt.mahawallet.xyz/transfer-preapproval"

-- The wallet-side transaction parser identifies the sender of an allocation settlement from this
-- well-known metadata key (see the token standard, "transaction history" metadata).
spliceMetaPrefix : Text
spliceMetaPrefix = "splice.lfdecentralizedtrust.org/"

senderMeta : Party -> M.Metadata
senderMeta sender = M.Metadata with
  values = TextMap.fromList [(spliceMetaPrefix <> "sender", partyToText sender)]

-- cUSDT has 6 decimals (as advertised by the registry); the ledger type has 10.
assertPrecision : Text -> Decimal -> Update ()
assertPrecision what x = assertMsg (what <> " has more than 6 decimals") (roundBankers 6 x == x)

-- Token Standard V2 helpers ---------------------------------------------------------------------------------
-- V2 addresses holdings by Account (owner, provider, id). cUSDT only has plain owner accounts: no provider, default id.
-- Accounts with owner = None (the admin-managed mint/burn accounts) are not used: the issuer mints with CusdtAdmin_Mint / BurnMint.
cusdtInstrumentIdV2 : Party -> H2.InstrumentId
cusdtInstrumentIdV2 admin = H2.InstrumentId with admin = admin, id = cusdtSymbol

v2Account : Party -> H2.Account
v2Account p = H2.Account with owner = Some p, provider = None, id = ""

v2Lock : H.Lock -> H2.Lock
v2Lock l = H2.Lock with holders = l.holders, expiresAt = l.expiresAt, expiresAfter = l.expiresAfter, context = l.context

accountOwner : Text -> H2.Account -> Update Party
accountOwner what a = do
  assertMsg (what <> " must be a plain owner account (no provider, default id)") (a.provider == None && a.id == "")
  case a.owner of
    Some p -> pure p
    None -> abort (what <> " account must have an owner (admin-managed accounts are not supported)")

v2Completed : [ContractId H2.Holding] -> [ContractId H2.Holding] -> TI2.TransferInstructionResult
v2Completed receiverCids changeCids = TI2.TransferInstructionResult with
  output = TI2.TransferInstructionResult_Completed with receiverHoldingCids = receiverCids
  senderChangeCids = changeCids
  meta = M.emptyMetadata

v2Failed : [ContractId H2.Holding] -> TI2.TransferInstructionResult
v2Failed changeCids = TI2.TransferInstructionResult with
  output = TI2.TransferInstructionResult_Failed
  senderChangeCids = changeCids
  meta = M.emptyMetadata

lockHolders : Optional H.Lock -> [Party]
lockHolders None = []
lockHolders (Some l) = l.holders

-- A lock is in force until its expiresAt (V1/V2: "absolute, inclusive deadline as of which the lock expires").
-- After that the holding behaves as unlocked everywhere in this token: no extra step is needed to use it.
lockActive : Time -> Optional H.Lock -> Bool
lockActive _ None = False
lockActive now (Some l) = case l.expiresAt of
  None -> True
  Some t -> now < t

-- Locks created by CusdtHolding_Lock carry this prefix in their context; only those can be released early by their holders
-- (an allocation lock, whose holder is the executor, can not).
voluntaryLockPrefix : Text
voluntaryLockPrefix = "cusdt/voluntary-lock: "

isVoluntaryLock : Optional H.Lock -> Bool
isVoluntaryLock None = False
isVoluntaryLock (Some l) = case l.context of
  Some c -> voluntaryLockPrefix `Text.isPrefixOf` c
  None -> False

completed : [ContractId H.Holding] -> [ContractId H.Holding] -> TI.TransferInstructionResult
completed receiverCids changeCids = TI.TransferInstructionResult with
  output = TI.TransferInstructionResult_Completed with receiverHoldingCids = receiverCids
  senderChangeCids = changeCids
  meta = M.emptyMetadata

failed : [ContractId H.Holding] -> TI.TransferInstructionResult
failed changeCids = TI.TransferInstructionResult with
  output = TI.TransferInstructionResult_Failed
  senderChangeCids = changeCids
  meta = M.emptyMetadata

-- Archive the given holdings and pay `amount` out of them; the rest comes back as change.
-- Every input must be an unlocked cUSDT holding of `sender`. Used by transfers and allocations.
spendInputs : Party -> Party -> Decimal -> [ContractId H.Holding] -> Update [ContractId H.Holding]
spendInputs admin sender amount inputCidsI = do
  change <- spendInputsT admin sender amount (map fromInterfaceContractId inputCidsI)
  pure (map toInterfaceContractId change)

spendInputsT : Party -> Party -> Decimal -> [ContractId CusdtHolding] -> Update [ContractId CusdtHolding]
spendInputsT admin sender amount inputCids = do
  now <- getTime
  inputs <- forA inputCids fetch
  forA_ inputs $ \h -> do
    assertMsg "input admin mismatch" (h.admin == admin)
    assertMsg "input not owned by sender" (h.owner == sender)
    assertMsg "input holding is locked" (not (lockActive now h.lock))
  let total = sum (map (\h -> h.amount) inputs)
  assertMsg "insufficient funds in inputs" (total >= amount)
  forA_ inputCids archive
  let change = total - amount
  if change > 0.0
    then do
      c <- create CusdtHolding with admin, owner = sender, amount = change, lock = None
      pure [c]
    else pure []

-- Unlock: archive a locked holding and give the same amount back to its owner, unlocked.
releaseLocked : ContractId CusdtHolding -> Update (ContractId H.Holding)
releaseLocked lockedCid = do
  locked <- fetch lockedCid
  archive lockedCid
  h <- create CusdtHolding with
    admin = locked.admin, owner = locked.owner, amount = locked.amount, lock = None
  pure (toInterfaceContractId h)

-- Holding ------------------------------------------------------------------

template CusdtHolding
  with
    admin  : Party
    owner  : Party
    amount : Decimal
    lock   : Optional H.Lock
  where
    signatory admin
    observer owner :: lockHolders lock
    ensure amount > 0.0

    interface instance H.Holding for CusdtHolding where
      view = H.HoldingView with
        owner = owner
        instrumentId = cusdtInstrumentId admin
        amount = amount
        lock = lock
        meta = M.emptyMetadata

    interface instance H2.Holding for CusdtHolding where
      view = H2.HoldingView with
        account = v2Account owner
        instrumentId = cusdtInstrumentIdV2 admin
        amount = amount
        lock = fmap v2Lock lock
        meta = M.emptyMetadata

    choice CusdtHolding_Split : (ContractId CusdtHolding, ContractId CusdtHolding)
      with splitAmount : Decimal
      controller owner
      do
        now <- getTime
        assertMsg "holding is locked" (not (lockActive now lock))
        assertMsg "splitAmount must be positive" (splitAmount > 0.0)
        assertMsg "splitAmount must be less than amount" (splitAmount < amount)
        assertPrecision "splitAmount" splitAmount
        a <- create CusdtHolding with admin, owner, amount = splitAmount, lock = None
        b <- create CusdtHolding with admin, owner, amount = amount - splitAmount, lock = None
        pure (a, b)

    -- Consolidate this holding with others (UTXO hygiene: keep holdings per user low).
    choice CusdtHolding_Merge : ContractId CusdtHolding
      with otherCids : [ContractId CusdtHolding]
      controller owner
      do
        now <- getTime
        assertMsg "holding is locked" (not (lockActive now lock))
        others <- forA otherCids fetch
        forA_ others $ \o -> do
          assertMsg "owner mismatch" (o.owner == owner)
          assertMsg "admin mismatch" (o.admin == admin)
          assertMsg "other holding is locked" (not (lockActive now o.lock))
        forA_ otherCids archive
        create CusdtHolding with admin, owner, amount = amount + sum (map (\o -> o.amount) others), lock = None

    -- Owner destroys their own holding (e.g. the admin burning redeemed cUSDT).
    -- The admin cannot use THIS choice on other people's holdings (as the only signatory of a holding it can still use Daml's built-in Archive on it).
    choice CusdtHolding_Burn : ()
      controller owner
      do
        now <- getTime
        assertMsg "holding is locked" (not (lockActive now lock))
        pure ()

    -- Voluntary lock: the owner locks the holding until `expiresAt`. The `holders` (e.g. an escrow or vesting agent) can release it
    -- early, all of them together; with no holders it is a pure time lock that nobody can shorten.
    choice CusdtHolding_Lock : ContractId CusdtHolding
      with
        holders   : [Party]
        expiresAt : Time
        context   : Text
      controller owner
      do
        now <- getTime
        assertMsg "holding is already locked" (not (lockActive now lock))
        assertMsg "expiresAt must be in the future" (expiresAt > now)
        assertMsg "the owner cannot be a lock holder (it could just unlock again)" (not (owner `elem` holders))
        create CusdtHolding with
          admin, owner, amount
          lock = Some (H.Lock with
            holders = holders
            expiresAt = Some expiresAt
            expiresAfter = None
            context = Some (voluntaryLockPrefix <> context))

    -- Early release of a VOLUNTARY lock by all its holders. An allocation lock can not be released this way.
    choice CusdtHolding_UnlockEarly : ContractId CusdtHolding
      controller lockHolders lock
      do
        assertMsg "only voluntary locks can be released early" (isVoluntaryLock lock)
        create CusdtHolding with admin, owner, amount, lock = None

    -- Tidy-up after expiry: the holding is spendable anyway once its lock has expired; this just drops the stale lock record.
    choice CusdtHolding_UnlockExpired : ContractId CusdtHolding
      controller owner
      do
        now <- getTime
        assertMsg "the holding has no expired lock" (lock /= None && not (lockActive now lock))
        create CusdtHolding with admin, owner, amount, lock = None

-- Issuer -------------------------------------------------------------------

template CusdtAdmin
  with
    admin : Party
  where
    signatory admin

    nonconsuming choice CusdtAdmin_Mint : ContractId CusdtHolding
      with
        recipient : Party
        amount    : Decimal
      controller admin
      do
        assertPrecision "mint amount" amount
        create CusdtHolding with admin, owner = recipient, amount, lock = None

    -- Lets `receiver` accept transfers directly (no per-transfer accept step).
    nonconsuming choice CusdtAdmin_CreatePreapproval : ContractId CusdtTransferPreapproval
      with receiver : Party
      controller admin
      do
        create CusdtTransferPreapproval with admin, receiver

    -- Issues new tokens that vest linearly for `beneficiary` (see CusdtVesting).
    nonconsuming choice CusdtAdmin_GrantVesting : ContractId CusdtVesting
      with
        beneficiary : Party
        amount      : Decimal
        start       : Time
        cliff       : Time
        finish      : Time
        revocable   : Bool
      controller admin
      do grantVesting admin beneficiary amount start cliff finish revocable

    -- Governance: hands a day-to-day operator a limited, expiring allowance (see CusdtOperatorAuthority).
    -- The admin (governor) keeps every power above; the operator only gets what is written in the delegation.
    nonconsuming choice CusdtAdmin_AppointOperator : ContractId CusdtOperatorAuthority
      with
        operator   : Party
        allowance  : Decimal
        validUntil : Time
      controller admin
      do
        assertMsg "operator must differ from the admin" (operator /= admin)
        assertMsg "allowance must not be negative" (allowance >= 0.0)
        assertPrecision "allowance" allowance
        create CusdtOperatorAuthority with admin, operator, allowance, validUntil

grantVesting : Party -> Party -> Decimal -> Time -> Time -> Time -> Bool -> Update (ContractId CusdtVesting)
grantVesting admin beneficiary amount start cliff finish revocable = do
  now <- getTime
  assertMsg "vesting amount must be positive" (amount > 0.0)
  assertPrecision "vesting amount" amount
  assertMsg "finish must be in the future" (finish > now)
  lockedCid <- create CusdtHolding with admin, owner = beneficiary, amount, lock = Some (vestingLock admin finish)
  create CusdtVesting with admin, beneficiary, total = amount, claimed = 0.0, start, cliff, finish, revocable, lockedCid

-- Operator delegation -----------------------------------------------------------------------------------
-- Signed by the admin (governor). The operator can mint and grant vestings only while `allowance` lasts
-- (every use shrinks it; the admin tops it up with _SetAllowance) and only until `validUntil`. It can also
-- create preapprovals. It cannot archive/change holdings, revoke vestings or run BurnMint. The admin
-- revokes the operator by archiving this contract (built-in Archive, the admin is the only signatory).
template CusdtOperatorAuthority
  with
    admin      : Party
    operator   : Party
    allowance  : Decimal
    validUntil : Time
  where
    signatory admin
    observer operator

    choice CusdtOperator_Mint : (ContractId CusdtHolding, ContractId CusdtOperatorAuthority)
      with
        recipient : Party
        amount    : Decimal
      controller operator
      do
        spendAllowance this amount
        assertPrecision "mint amount" amount
        h <- create CusdtHolding with admin, owner = recipient, amount, lock = None
        a <- create this with allowance = allowance - amount
        pure (h, a)

    choice CusdtOperator_GrantVesting : (ContractId CusdtVesting, ContractId CusdtOperatorAuthority)
      with
        beneficiary : Party
        amount      : Decimal
        start       : Time
        cliff       : Time
        finish      : Time
        revocable   : Bool
      controller operator
      do
        spendAllowance this amount
        v <- grantVesting admin beneficiary amount start cliff finish revocable
        a <- create this with allowance = allowance - amount
        pure (v, a)

    nonconsuming choice CusdtOperator_CreatePreapproval : ContractId CusdtTransferPreapproval
      with receiver : Party
      controller operator
      do
        now <- getTime
        assertMsg "operator authority expired" (now < validUntil)
        create CusdtTransferPreapproval with admin, receiver

    -- Governance only: new allowance and expiry (up or down).
    choice CusdtOperatorAuthority_SetAllowance : ContractId CusdtOperatorAuthority
      with
        newAllowance  : Decimal
        newValidUntil : Time
      controller admin
      do
        assertMsg "allowance must not be negative" (newAllowance >= 0.0)
        assertPrecision "allowance" newAllowance
        create this with allowance = newAllowance, validUntil = newValidUntil

spendAllowance : CusdtOperatorAuthority -> Decimal -> Update ()
spendAllowance a amount = do
  now <- getTime
  assertMsg "operator authority expired" (now < a.validUntil)
  assertMsg "amount must be positive" (amount > 0.0)
  assertMsg "amount exceeds the operator allowance" (amount <= a.allowance)

-- Preapproval ----------------------------------------------------------------

template CusdtTransferPreapproval
  with
    admin    : Party
    receiver : Party
  where
    signatory admin
    observer receiver

    -- The receiver can opt out at any time (the admin can too, via Archive).
    choice CusdtTransferPreapproval_Cancel : ()
      controller receiver
      do pure ()

-- Transfer factory ---------------------------------------------------------

template CusdtTransferFactory
  with
    admin : Party
  where
    signatory admin

    interface instance TI.TransferFactory for CusdtTransferFactory where
      view = TI.TransferFactoryView with admin = admin, meta = M.emptyMetadata

      transferFactory_publicFetchImpl _self arg = do
        assertMsg "expectedAdmin mismatch" (arg.expectedAdmin == admin)
        pure (TI.TransferFactoryView with admin = admin, meta = M.emptyMetadata)

      transferFactory_transferImpl _self arg = do
        let t = arg.transfer
        assertMsg "expectedAdmin mismatch" (arg.expectedAdmin == admin)
        assertMsg "wrong instrument" (t.instrumentId == cusdtInstrumentId admin)
        assertMsg "amount must be positive" (t.amount > 0.0)
        assertPrecision "amount" t.amount
        assertMsg "inputHoldingCids required" (not (null t.inputHoldingCids))
        now <- getTime
        assertMsg "requestedAt must be in the past" (t.requestedAt <= now)
        assertMsg "executeBefore must be in the future" (t.executeBefore > now)

        changeCids <- spendInputs admin t.sender t.amount t.inputHoldingCids

        -- A preapproval cid in the choice context (put there by the registry) means "direct".
        let preapprovalCid : Optional (ContractId CusdtTransferPreapproval) =
              case TextMap.lookup preapprovalKey arg.extraArgs.context.values of
                Some (M.AV_ContractId anyCid) -> Some (coerceContractId anyCid)
                _ -> None

        if t.sender == t.receiver
          then do
            rcv <- create CusdtHolding with admin, owner = t.receiver, amount = t.amount, lock = None
            pure (completed [toInterfaceContractId rcv] changeCids)
          else do
            case preapprovalCid of
              Some pcid -> do
                p <- fetch pcid
                assertMsg "preapproval admin mismatch" (p.admin == admin)
                assertMsg "preapproval is for a different receiver" (p.receiver == t.receiver)
                rcv <- create CusdtHolding with admin, owner = t.receiver, amount = t.amount, lock = None
                pure (completed [toInterfaceContractId rcv] changeCids)
              None -> do
                ti <- create CusdtTransferInstruction with
                  admin
                  transfer = t with inputHoldingCids = []
                pure TI.TransferInstructionResult with
                  output = TI.TransferInstructionResult_Pending with
                    transferInstructionCid = toInterfaceContractId ti
                  senderChangeCids = changeCids
                  meta = M.emptyMetadata

    -- V2: no expectedAdmin, the controllers are a free list of actors. The factory therefore checks everything itself;
    -- above all that the SENDER is among the actors, because the holdings' only signatory is the admin.
    interface instance TI2.TransferFactory for CusdtTransferFactory where
      view = TI2.TransferFactoryView with admin = admin, meta = M.emptyMetadata

      transferFactory_transferExtraObservers _arg = []

      transferFactory_publicFetchImpl _self _arg =
        pure (TI2.TransferFactoryView with admin = admin, meta = M.emptyMetadata)

      transferFactory_transferImpl _self arg = do
        let t = arg.transfer
        sender <- accountOwner "sender" t.sender
        receiver <- accountOwner "receiver" t.receiver
        assertMsg "the sender must be among the actors" (sender `elem` arg.actors)
        assertMsg "wrong instrument" (t.instrumentId == cusdtInstrumentIdV2 admin)
        assertMsg "amount must be positive" (t.amount > 0.0)
        assertPrecision "amount" t.amount
        assertMsg "inputHoldingCids required" (not (null t.inputHoldingCids))
        now <- getTime
        assertMsg "requestedAt must be in the past" (t.requestedAt <= now)
        assertMsg "executeBefore must be in the future" (t.executeBefore > now)

        changeT <- spendInputsT admin sender t.amount (map fromInterfaceContractId t.inputHoldingCids)
        let changeCids : [ContractId H2.Holding] = map toInterfaceContractId changeT

        let preapprovalCid : Optional (ContractId CusdtTransferPreapproval) =
              case TextMap.lookup preapprovalKey arg.extraArgs.context.values of
                Some (M.AV_ContractId anyCid) -> Some (coerceContractId anyCid)
                _ -> None

        if sender == receiver
          then do
            rcv <- create CusdtHolding with admin, owner = receiver, amount = t.amount, lock = None
            pure (v2Completed [toInterfaceContractId rcv] changeCids)
          else do
            case preapprovalCid of
              Some pcid -> do
                p <- fetch pcid
                assertMsg "preapproval admin mismatch" (p.admin == admin)
                assertMsg "preapproval is for a different receiver" (p.receiver == receiver)
                rcv <- create CusdtHolding with admin, owner = receiver, amount = t.amount, lock = None
                pure (v2Completed [toInterfaceContractId rcv] changeCids)
              None -> do
                ti <- create CusdtTransferInstruction with
                  admin
                  transfer = TI.Transfer with
                    sender = sender
                    receiver = receiver
                    amount = t.amount
                    instrumentId = cusdtInstrumentId admin
                    requestedAt = t.requestedAt
                    executeBefore = t.executeBefore
                    inputHoldingCids = []
                    meta = t.meta
                pure TI2.TransferInstructionResult with
                  output = TI2.TransferInstructionResult_Pending with
                    transferInstructionCid = toInterfaceContractId ti
                  senderChangeCids = changeCids
                  meta = M.emptyMetadata

-- Transfer instruction (receiver must accept) -------------------------------

template CusdtTransferInstruction
  with
    admin    : Party
    transfer : TI.Transfer
  where
    signatory admin, transfer.sender
    observer transfer.receiver
    ensure transfer.amount > 0.0

    interface instance TI.TransferInstruction for CusdtTransferInstruction where
      view = TI.TransferInstructionView with
        originalInstructionCid = None
        transfer = transfer
        status = TI.TransferPendingReceiverAcceptance
        meta = M.emptyMetadata

      transferInstruction_acceptImpl _self _arg = do
        now <- getTime
        assertMsg "transfer expired" (now < transfer.executeBefore)
        h <- create CusdtHolding with
          admin, owner = transfer.receiver, amount = transfer.amount, lock = None
        pure (completed [toInterfaceContractId h] [])

      transferInstruction_rejectImpl _self _arg = do
        h <- create CusdtHolding with
          admin, owner = transfer.sender, amount = transfer.amount, lock = None
        pure (failed [toInterfaceContractId h])

      transferInstruction_withdrawImpl _self _arg = do
        h <- create CusdtHolding with
          admin, owner = transfer.sender, amount = transfer.amount, lock = None
        pure (failed [toInterfaceContractId h])

      -- No registry-internal workflow steps exist for cUSDT.
      transferInstruction_updateImpl _self _arg =
        abort "cUSDT transfer instructions have no registry-internal update steps"

    -- V2 choices are NON-consuming: the implementations archive the instruction themselves, and check that the right party acts.
    interface instance TI2.TransferInstruction for CusdtTransferInstruction where
      view = TI2.TransferInstructionView with
        originalInstructionCid = None
        transfer = TI2.Transfer with
          sender = v2Account transfer.sender
          receiver = v2Account transfer.receiver
          amount = transfer.amount
          instrumentId = cusdtInstrumentIdV2 admin
          requestedAt = transfer.requestedAt
          executeBefore = transfer.executeBefore
          inputHoldingCids = []
          meta = transfer.meta
        expiresAt = Some transfer.executeBefore
        availableActions = Map.fromList
          [ (TI2.TIA_Accept, [[transfer.receiver]])
          , (TI2.TIA_Reject, [[transfer.receiver]])
          , (TI2.TIA_Withdraw, [[transfer.sender]]) ]
        meta = M.emptyMetadata

      transferInstruction_acceptExtraObservers _arg = []
      transferInstruction_rejectExtraObservers _arg = []
      transferInstruction_withdrawExtraObservers _arg = []

      transferInstruction_acceptImpl selfCid arg = do
        assertMsg "the receiver must be among the actors" (transfer.receiver `elem` arg.actors)
        now <- getTime
        assertMsg "transfer expired" (now < transfer.executeBefore)
        archive (fromInterfaceContractId @CusdtTransferInstruction selfCid)
        h <- create CusdtHolding with
          admin, owner = transfer.receiver, amount = transfer.amount, lock = None
        pure (v2Completed [toInterfaceContractId h] [])

      transferInstruction_rejectImpl selfCid arg = do
        assertMsg "the receiver must be among the actors" (transfer.receiver `elem` arg.actors)
        archive (fromInterfaceContractId @CusdtTransferInstruction selfCid)
        h <- create CusdtHolding with
          admin, owner = transfer.sender, amount = transfer.amount, lock = None
        pure (v2Failed [toInterfaceContractId h])

      transferInstruction_withdrawImpl selfCid arg = do
        assertMsg "the sender must be among the actors" (transfer.sender `elem` arg.actors)
        archive (fromInterfaceContractId @CusdtTransferInstruction selfCid)
        h <- create CusdtHolding with
          admin, owner = transfer.sender, amount = transfer.amount, lock = None
        pure (v2Failed [toInterfaceContractId h])

-- Allocation (atomic settlement) ----------------------------------------------

-- Reserves `leg.amount` of the sender's cUSDT for a settlement run by `executor`.
-- The funds sit in a locked CusdtHolding (not spendable) until executed, cancelled or withdrawn.
template CusdtAllocationFactory
  with
    admin : Party
  where
    signatory admin

    interface instance AI.AllocationFactory for CusdtAllocationFactory where
      view = AI.AllocationFactoryView with admin = admin, meta = M.emptyMetadata

      allocationFactory_publicFetchImpl _self arg = do
        assertMsg "expectedAdmin mismatch" (arg.expectedAdmin == admin)
        pure (AI.AllocationFactoryView with admin = admin, meta = M.emptyMetadata)

      allocationFactory_allocateImpl _self arg = do
        let spec = arg.allocation
        let leg = spec.transferLeg
        let settlement = spec.settlement
        assertMsg "expectedAdmin mismatch" (arg.expectedAdmin == admin)
        assertMsg "wrong instrument" (leg.instrumentId == cusdtInstrumentId admin)
        assertMsg "amount must be positive" (leg.amount > 0.0)
        assertPrecision "amount" leg.amount
        assertMsg "inputHoldingCids required" (not (null arg.inputHoldingCids))
        now <- getTime
        assertMsg "requestedAt must be in the past" (arg.requestedAt <= now)
        assertMsg "allocateBefore must be in the future" (settlement.allocateBefore > now)
        assertMsg "settleBefore must be after allocateBefore" (settlement.settleBefore > settlement.allocateBefore)

        changeCids <- spendInputs admin leg.sender leg.amount arg.inputHoldingCids
        lockedCid <- create CusdtHolding with
          admin
          owner = leg.sender
          amount = leg.amount
          lock = Some (H.Lock with
            holders = [settlement.executor]
            expiresAt = Some settlement.settleBefore
            expiresAfter = None
            context = Some "cUSDT settlement allocation")
        alloc <- create CusdtAllocation with admin, allocation = spec, lockedCid
        pure AI.AllocationInstructionResult with
          output = AI.AllocationInstructionResult_Completed with
            allocationCid = toInterfaceContractId alloc
          senderChangeCids = changeCids
          meta = M.emptyMetadata

template CusdtAllocation
  with
    admin      : Party
    allocation : A.AllocationSpecification
    lockedCid  : ContractId CusdtHolding
  where
    signatory admin, allocation.transferLeg.sender
    observer allocation.settlement.executor, allocation.transferLeg.receiver

    interface instance A.Allocation for CusdtAllocation where
      view = A.AllocationView with
        allocation = allocation
        holdingCids = [toInterfaceContractId lockedCid]
        meta = M.emptyMetadata

      allocation_executeTransferImpl _self _arg = do
        now <- getTime
        assertMsg "settleBefore passed" (now < allocation.settlement.settleBefore)
        locked <- fetch lockedCid
        archive lockedCid
        rcv <- create CusdtHolding with
          admin, owner = allocation.transferLeg.receiver, amount = locked.amount, lock = None
        pure A.Allocation_ExecuteTransferResult with
          senderHoldingCids = []
          receiverHoldingCids = [toInterfaceContractId rcv]
          meta = senderMeta allocation.transferLeg.sender

      allocation_cancelImpl _self _arg = do
        h <- releaseLocked lockedCid
        pure A.Allocation_CancelResult with
          senderHoldingCids = [h]
          meta = M.emptyMetadata

      allocation_withdrawImpl _self _arg = do
        h <- releaseLocked lockedCid
        pure A.Allocation_WithdrawResult with
          senderHoldingCids = [h]
          meta = M.emptyMetadata

    -- An expired lock no longer blocks the owner, so after settleBefore the locked holding may already have been spent and
    -- Allocation_Withdraw would fail on the missing holding. The sender can always drop an expired allocation with this choice.
    choice CusdtAllocation_DiscardExpired : ()
      controller allocation.transferLeg.sender
      do
        now <- getTime
        assertMsg "the settlement window has not passed yet" (now >= allocation.settlement.settleBefore)
        pure ()

-- Settlement authority (cross-participant / cross-kind settlement) ---------------------------------------
--
-- Allocation_ExecuteTransfer needs the joint authority of executor + sender + receiver, and ONE node can only
-- submit for the parties it hosts. The token standard's answer: sender and receiver delegate to the executor
-- through a contract THEY sign. In the body of a choice, the authority of the contract's signatories (sender,
-- receiver) is available next to the controller (executor), so the executor alone can settle, from its own node.
--
-- The executor can only settle (or cancel) allocations whose executor / sender / receiver / settlementRef
-- match, before `expiresAt`; the leg (who gets what) is fixed in the allocation. Sender or receiver revoke
-- the delegation any time with CusdtSettlement_RevokeBySender / _RevokeByReceiver (the built-in Archive would need both).

template CusdtSettlementProposal
  with
    executor        : Party
    sender          : Party
    receiver        : Party
    settlementRefId : Text
    expiresAt       : Time
  where
    signatory sender
    observer receiver, executor
    ensure sender /= receiver

    choice CusdtSettlementProposal_Accept : ContractId CusdtSettlementAuthority
      controller receiver
      do
        now <- getTime
        assertMsg "proposal expired" (now < expiresAt)
        create CusdtSettlementAuthority with executor, sender, receiver, settlementRefId, expiresAt

    choice CusdtSettlementProposal_Reject : ()
      controller receiver
      do pure ()

template CusdtSettlementAuthority
  with
    executor        : Party
    sender          : Party
    receiver        : Party
    settlementRefId : Text
    expiresAt       : Time
  where
    signatory sender, receiver
    observer executor

    -- Either party can revoke ALONE. Daml's built-in Archive needs ALL signatories at once, which is impossible when
    -- sender and receiver are hosted on different nodes (found in test 22: a 0.4.0 authority could not be revoked).
    choice CusdtSettlement_RevokeBySender : ()
      controller sender
      do pure ()

    choice CusdtSettlement_RevokeByReceiver : ()
      controller receiver
      do pure ()

    nonconsuming choice CusdtSettlement_Execute : A.Allocation_ExecuteTransferResult
      with
        allocationCid : ContractId A.Allocation
        extraArgs     : M.ExtraArgs
      controller executor
      do
        checkDelegation this allocationCid
        exercise allocationCid (A.Allocation_ExecuteTransfer with extraArgs)

    nonconsuming choice CusdtSettlement_Cancel : A.Allocation_CancelResult
      with
        allocationCid : ContractId A.Allocation
        extraArgs     : M.ExtraArgs
      controller executor
      do
        checkDelegation this allocationCid
        exercise allocationCid (A.Allocation_Cancel with extraArgs)

-- The allocation must be exactly the one this delegation was granted for.
checkDelegation : CusdtSettlementAuthority -> ContractId A.Allocation -> Update ()
checkDelegation d allocationCid = do
  now <- getTime
  assertMsg "settlement authority expired" (now < d.expiresAt)
  alloc <- fetch allocationCid
  let v = view alloc
  assertMsg "allocation has a different executor" (v.allocation.settlement.executor == d.executor)
  assertMsg "allocation has a different sender" (v.allocation.transferLeg.sender == d.sender)
  assertMsg "allocation has a different receiver" (v.allocation.transferLeg.receiver == d.receiver)
  assertMsg "allocation belongs to a different settlement" (v.allocation.settlement.settlementRef.id == d.settlementRefId)

-- Burn / mint (optional token-standard interface) --------------------------------------------------------
--
-- Generic "burn these holdings, create those" operation for bridges and wallets (Splice.Api.Token.BurnMintV1).
-- The admin ALWAYS controls it (the standard says so), which is the same power as CusdtAdmin_Mint and the built-in
-- Archive; the choice is just the standard, parseable way to use it. Rules enforced here:
--   * every input is an unlocked cUSDT holding of THIS admin and its owner is among `extraActors` (burning needs the owner's consent),
--   * outputs are positive with at most 6 decimals; output owners need no consent (a credit),
--   * the totals of inputs and outputs may differ: that is what makes it usable as a bridge mint/burn.
template CusdtBurnMintFactory
  with
    admin : Party
  where
    signatory admin

    interface instance BM.BurnMintFactory for CusdtBurnMintFactory where
      view = BM.BurnMintFactoryView with admin = admin, meta = M.emptyMetadata

      burnMintFactory_publicFetchImpl _self arg = do
        assertMsg "expectedAdmin mismatch" (arg.expectedAdmin == admin)
        pure (BM.BurnMintFactoryView with admin = admin, meta = M.emptyMetadata)

      burnMintFactory_burnMintImpl _self arg = do
        assertMsg "expectedAdmin mismatch" (arg.expectedAdmin == admin)
        assertMsg "wrong instrument" (arg.instrumentId == cusdtInstrumentId admin)
        assertMsg "nothing to burn or mint" (not (null arg.inputHoldingCids && null arg.outputs))
        now <- getTime
        let inputCids : [ContractId CusdtHolding] = map fromInterfaceContractId arg.inputHoldingCids
        inputs <- forA inputCids fetch
        forA_ inputs $ \h -> do
          assertMsg "input admin mismatch" (h.admin == admin)
          assertMsg "input holding is locked" (not (lockActive now h.lock))
          assertMsg "owner of a burnt holding must be an extra actor" (h.owner `elem` arg.extraActors)
        forA_ arg.outputs $ \o -> do
          assertMsg "output amount must be positive" (o.amount > 0.0)
          assertPrecision "output amount" o.amount
          assertMsg "output context is not supported" (TextMap.null o.context.values)
        forA_ inputCids archive
        created <- forA arg.outputs $ \o ->
          create CusdtHolding with admin, owner = o.owner, amount = o.amount, lock = None
        pure BM.BurnMintFactory_BurnMintResult with outputCids = map toInterfaceContractId created

-- Linear vesting -----------------------------------------------------------------------------------------------
--
-- The issuer grants tokens that are released linearly between `start` and `finish` (nothing before `cliff`; at the cliff the share
-- elapsed since `start` becomes claimable, so a cliff does not restart the clock). The unreleased remainder is an ordinary LOCKED
-- CusdtHolding of the beneficiary (lock holder = admin, expiring at `finish`), so wallets show it as locked balance; the CusdtVesting
-- contract only keeps the schedule. The beneficiary claims what has vested at any time; a revocable grant can be revoked by the admin,
-- which pays the vested part to the beneficiary and returns the unvested part to the admin.
--
-- Trust note: the admin is the only signatory of every holding, so it can still Archive a vesting holding. "Locked" and "vested" mean
-- what THIS CONTRACT enforces, not a guarantee against the issuer.

vestingLockPrefix : Text
vestingLockPrefix = "cusdt/vesting: "

vestingLock : Party -> Time -> H.Lock
vestingLock admin finish = H.Lock with
  holders = admin :: []
  expiresAt = Some finish
  expiresAfter = None
  context = Some (vestingLockPrefix <> "linear vesting, fully released at the end")

-- rounds down to the 6 decimals of cUSDT
floorMicro : Decimal -> Decimal
floorMicro x = intToDecimal (truncate (x * 1000000.0)) / 1000000.0

-- how much of `total` has vested at `now`
vestedAmount : Time -> Time -> Time -> Time -> Decimal -> Decimal
vestedAmount now start cliff finish total
  | now < cliff = 0.0
  | now >= finish = total
  | otherwise =
      let elapsed = convertRelTimeToMicroseconds (subTime now start)
          duration = convertRelTimeToMicroseconds (subTime finish start)
      in floorMicro (total * intToDecimal elapsed / intToDecimal duration)

template CusdtVesting
  with
    admin       : Party
    beneficiary : Party
    total       : Decimal
    claimed     : Decimal
    start       : Time
    cliff       : Time
    finish      : Time
    revocable   : Bool
    lockedCid   : ContractId CusdtHolding
  where
    signatory admin
    observer beneficiary
    ensure total > 0.0 && claimed >= 0.0 && claimed < total && start < finish && start <= cliff && cliff <= finish

    -- The beneficiary takes everything that has vested and not been claimed yet.
    choice CusdtVesting_Claim : (ContractId CusdtHolding, Optional (ContractId CusdtVesting))
      controller beneficiary
      do
        now <- getTime
        let releasable = vestedAmount now start cliff finish total - claimed
        assertMsg "nothing has vested yet" (releasable > 0.0)
        locked <- fetch lockedCid
        assertMsg "the locked holding does not match the schedule" (locked.amount == total - claimed)
        archive lockedCid
        released <- create CusdtHolding with admin, owner = beneficiary, amount = releasable, lock = None
        let remaining = total - claimed - releasable
        if remaining > 0.0
          then do
            newLocked <- create CusdtHolding with admin, owner = beneficiary, amount = remaining, lock = Some (vestingLock admin finish)
            v <- create this with claimed = claimed + releasable, lockedCid = newLocked
            pure (released, Some v)
          else pure (released, None)

    -- Admin only, and only for a revocable grant: the vested part goes to the beneficiary, the unvested part back to the admin.
    choice CusdtVesting_Revoke : (Optional (ContractId CusdtHolding), Optional (ContractId CusdtHolding))
      controller admin
      do
        assertMsg "this vesting is not revocable" revocable
        now <- getTime
        let vested = vestedAmount now start cliff finish total
        let releasable = vested - claimed
        let unvested = total - vested
        archive lockedCid
        toBeneficiary <- if releasable > 0.0
          then fmap Some (create CusdtHolding with admin, owner = beneficiary, amount = releasable, lock = None)
          else pure None
        toAdmin <- if unvested > 0.0
          then fmap Some (create CusdtHolding with admin, owner = admin, amount = unvested, lock = None)
          else pure None
        pure (toBeneficiary, toAdmin)

    -- After the end the lock has expired, so the beneficiary may already have spent the holding and a claim could fail on the missing
    -- holding: the beneficiary can always drop the finished schedule.
    choice CusdtVesting_Close : ()
      controller beneficiary
      do
        now <- getTime
        assertMsg "the vesting has not finished yet" (now >= finish)
        pure ()
