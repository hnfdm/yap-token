-- Daml Script tests for the governed actions (daml/yap-governance).
-- The governance machinery itself (GovernanceRules: threshold, confirmations, expiry) belongs to DecMan and is tested there; here
-- `gov` plays "the governance party after enough confirmations": it exercises GovernableAction_Execute on a proposal that a member created.
module YapGovernanceTest where

import Daml.Script
import DA.Time
import DA.Date
import YapToken
import YapGovernance
import Governance.Action

data W = W with
  gov    : Party   -- the decentralized governor (YAP admin)
  member : Party   -- a member that proposes
  op     : Party   -- an operator
  alice  : Party
  other  : Party   -- some unrelated issuer
  adm    : ContractId YapAdmin

setup : Script W
setup = do
  gov <- allocateParty "gov"
  member <- allocateParty "member"
  op <- allocateParty "op"
  alice <- allocateParty "alice"
  other <- allocateParty "other"
  setTime (time (date 2026 Oct 22) 9 0 0)
  adm <- submit gov do createCmd YapAdmin with admin = gov
  pure W with ..

-- the governance step: members confirmed, GovernanceRules executes (here: the governance party exercises Execute)
execute : (Template t, Implements t GovernableAction) => Party -> ContractId t -> Script ()
execute who pid = submit who do
  exerciseCmd (toInterfaceContractId @GovernableAction pid) GovernableAction_Execute

executeFails : (Template t, Implements t GovernableAction) => Party -> ContractId t -> Script ()
executeFails who pid = submitMustFail who do
  exerciseCmd (toInterfaceContractId @GovernableAction pid) GovernableAction_Execute

allowanceOf : W -> Script [(ContractId YapOperatorAuthority, YapOperatorAuthority)]
allowanceOf w = do
  as <- query @YapOperatorAuthority w.gov
  pure [ (c, a) | (c, a) <- as, a.operator == w.op ]

testAppointOperator : Script ()
testAppointOperator = do
  w <- setup
  now <- getTime
  p <- submit w.member do
    createCmd AppointOperatorProposal with governanceParty = w.gov, proposer = w.member, adminCid = w.adm, operator = w.op, allowance = 100.0, validUntil = addRelTime now (days 30)
  executeFails w.member p                       -- a member alone cannot execute: only the governance party can
  executeFails w.op p
  [] <- allowanceOf w
  execute w.gov p
  [(_, a)] <- allowanceOf w
  assertMsg "allowance 100" (a.allowance == 100.0)
  assertMsg "admin is the governance party" (a.admin == w.gov)

testAppointGuards : Script ()
testAppointGuards = do
  w <- setup
  now <- getTime
  let go op al = submitMustFail w.member do
        createCmd AppointOperatorProposal with governanceParty = w.gov, proposer = w.member, adminCid = w.adm, operator = op, allowance = al, validUntil = addRelTime now (days 1)
  go w.gov 10.0                                 -- operator = governance party
  go w.op (-1.0)                                -- negative allowance
  -- a YapAdmin of ANOTHER issuer cannot be used through this governance party
  otherAdm <- submit w.other do createCmd YapAdmin with admin = w.other
  p <- submit w.member do
    createCmd AppointOperatorProposal with governanceParty = w.gov, proposer = w.member, adminCid = otherAdm, operator = w.op, allowance = 1.0, validUntil = addRelTime now (days 1)
  executeFails w.gov p
  [] <- allowanceOf w
  pure ()

testSetAllowanceAndStaleCid : Script ()
testSetAllowanceAndStaleCid = do
  w <- setup
  now <- getTime
  auth <- appoint w 100.0
  -- the operator mints: the authority contract is consumed and recreated, the old id is stale
  _ <- submit w.op do exerciseCmd auth YapOperator_Mint with recipient = w.alice, amount = 10.0
  stale <- submit w.member do
    createCmd SetOperatorAllowanceProposal with governanceParty = w.gov, proposer = w.member, authorityCid = auth, newAllowance = 500.0, newValidUntil = addRelTime now (days 60)
  executeFails w.gov stale
  [(cur, a0)] <- allowanceOf w
  assertMsg "still 90 after the failed top-up" (a0.allowance == 90.0)
  fresh <- submit w.member do
    createCmd SetOperatorAllowanceProposal with governanceParty = w.gov, proposer = w.member, authorityCid = cur, newAllowance = 500.0, newValidUntil = addRelTime now (days 60)
  execute w.gov fresh
  [(_, a1)] <- allowanceOf w
  assertMsg "topped up to 500" (a1.allowance == 500.0)
  submitMustFail w.member do                    -- negative allowance is refused at proposal time
    createCmd SetOperatorAllowanceProposal with governanceParty = w.gov, proposer = w.member, authorityCid = cur, newAllowance = -1.0, newValidUntil = now

testRevokeOperator : Script ()
testRevokeOperator = do
  w <- setup
  auth <- appoint w 100.0
  p <- submit w.member do createCmd RevokeOperatorProposal with governanceParty = w.gov, proposer = w.member, authorityCid = auth
  executeFails w.op p
  execute w.gov p
  [] <- allowanceOf w
  submitMustFail w.op do exerciseCmd auth YapOperator_Mint with recipient = w.alice, amount = 1.0
  pure ()

testRevokeVesting : Script ()
testRevokeVesting = do
  w <- setup
  now <- getTime
  v <- submit w.gov do
    exerciseCmd w.adm YapAdmin_GrantVesting with beneficiary = w.alice, amount = 100.0, start = now, cliff = now, finish = addRelTime now (days 10), revocable = True
  passTime (days 5)
  p <- submit w.member do createCmd RevokeVestingProposal with governanceParty = w.gov, proposer = w.member, vestingCid = v
  executeFails w.alice p
  execute w.gov p
  vs <- query @YapVesting w.gov
  assertMsg "the vesting is gone" (null vs)
  hs <- query @YapHolding w.gov
  let aliceGot = sum [ h.amount | (_, h) <- hs, h.owner == w.alice, h.lock == None ]
  let govGot = sum [ h.amount | (_, h) <- hs, h.owner == w.gov ]
  assertMsg ("half vested to alice, half back to the governor, got " <> show aliceGot <> " / " <> show govGot) (aliceGot == 50.0 && govGot == 50.0)

testGovernorMint : Script ()
testGovernorMint = do
  w <- setup
  p <- submit w.member do createCmd GovernorMintProposal with governanceParty = w.gov, proposer = w.member, adminCid = w.adm, recipient = w.alice, amount = 7.0
  executeFails w.member p
  execute w.gov p
  hs <- query @YapHolding w.gov
  assertMsg "alice has 7" (sum [ h.amount | (_, h) <- hs, h.owner == w.alice ] == 7.0)
  submitMustFail w.member do createCmd GovernorMintProposal with governanceParty = w.gov, proposer = w.member, adminCid = w.adm, recipient = w.alice, amount = 0.0

testRescueHolding : Script ()
testRescueHolding = do
  w <- setup
  h <- submit w.gov do createCmd YapHolding with admin = w.gov, owner = w.alice, amount = 5.0, lock = None
  hOther <- submit w.other do createCmd YapHolding with admin = w.other, owner = w.alice, amount = 5.0, lock = None
  submitMustFail w.member do createCmd RescueHoldingProposal with governanceParty = w.gov, proposer = w.member, holdingCid = h, reason = ""
  p <- submit w.member do createCmd RescueHoldingProposal with governanceParty = w.gov, proposer = w.member, holdingCid = h, reason = "reported stolen"
  executeFails w.alice p
  execute w.gov p
  hs <- query @YapHolding w.gov
  assertMsg "the rescued holding is gone" (null hs)
  -- a holding of another issuer cannot be rescued through this governance party
  pOther <- submit w.member do createCmd RescueHoldingProposal with governanceParty = w.gov, proposer = w.member, holdingCid = hOther, reason = "wrong issuer"
  executeFails w.gov pOther

-- the proposal views carry what DecMan shows to the confirming members
testProposalViews : Script ()
testProposalViews = do
  w <- setup
  now <- getTime
  p <- submit w.member do
    createCmd AppointOperatorProposal with governanceParty = w.gov, proposer = w.member, adminCid = w.adm, operator = w.op, allowance = 100.0, validUntil = addRelTime now (days 30)
  Some c <- queryContractId w.gov p
  let v = view (toInterface @GovernableAction c)
  assertMsg "label" (v.actionLabel == "YapAppointOperator")
  assertMsg "governance party" (v.governanceParty == w.gov)
  assertMsg "proposer" (v.proposer == w.member)

testBurnTreasury : Script ()
testBurnTreasury = do
  w <- setup
  f <- submit w.gov do createCmd YapBurnMintFactory with admin = w.gov
  t1 <- submit w.gov do createCmd YapHolding with admin = w.gov, owner = w.gov, amount = 4.0, lock = None
  t2 <- submit w.gov do createCmd YapHolding with admin = w.gov, owner = w.gov, amount = 6.0, lock = None
  a1 <- submit w.gov do createCmd YapHolding with admin = w.gov, owner = w.alice, amount = 5.0, lock = None
  let propose cids = submit w.member do
        createCmd BurnTreasuryProposal with governanceParty = w.gov, proposer = w.member, factoryCid = f, holdingCids = cids
  submitMustFail w.member do createCmd BurnTreasuryProposal with governanceParty = w.gov, proposer = w.member, factoryCid = f, holdingCids = []
  pAlice <- propose [a1]                         -- somebody else's holding cannot be burnt by governance alone
  executeFails w.gov pAlice
  pMixed <- propose [t1, a1]
  executeFails w.gov pMixed
  p <- propose [t1, t2]
  executeFails w.member p
  execute w.gov p
  hs <- query @YapHolding w.gov
  assertMsg "only alice's 5 is left" (sum [ h.amount | (_, h) <- hs ] == 5.0 && length hs == 1)

testFixedSupplyTreasury : Script ()
testFixedSupplyTreasury = do
  w <- setup
  now <- getTime
  tf <- submit w.gov do createCmd YapTransferFactory with admin = w.gov
  -- one-time issuance of the whole supply to the governor itself
  treasury <- submit w.gov do createCmd YapHolding with admin = w.gov, owner = w.gov, amount = 1000.0, lock = None
  let supply = do
        hs <- query @YapHolding w.gov
        vs <- query @YapTransferInstruction w.gov
        pure (sum [ h.amount | (_, h) <- hs ] + sum [ i.transfer.amount | (_, i) <- vs ])
  -- a vesting grant funded from the treasury: the supply does not change
  pv <- submit w.member do
    createCmd GrantVestingFromTreasuryProposal with governanceParty = w.gov, proposer = w.member, adminCid = w.adm, treasuryCids = [treasury], beneficiary = w.alice, amount = 300.0, start = now, cliff = now, finish = addRelTime now (days 10), revocable = True
  executeFails w.member pv
  execute w.gov pv
  s1 <- supply
  assertMsg ("supply still 1000, got " <> show s1) (s1 == 1000.0)
  locked <- query @YapHolding w.gov
  assertMsg "alice has 300 locked" (sum [ h.amount | (_, h) <- locked, h.owner == w.alice, h.lock /= None ] == 300.0)
  assertMsg "the treasury kept 700 as change" (sum [ h.amount | (_, h) <- locked, h.owner == w.gov ] == 700.0)
  -- more than the treasury holds is refused
  [(rest, _)] <- pure [ (c, h) | (c, h) <- locked, h.owner == w.gov ]
  pBig <- submit w.member do
    createCmd GrantVestingFromTreasuryProposal with governanceParty = w.gov, proposer = w.member, adminCid = w.adm, treasuryCids = [rest], beneficiary = w.bob, amount = 700.01, start = now, cliff = now, finish = addRelTime now (days 10), revocable = False
  executeFails w.gov pBig
  -- a plain transfer out of the treasury (an offer that bob accepts later); supply still 1000
  pt <- submit w.member do
    createCmd TreasuryTransferProposal with governanceParty = w.gov, proposer = w.member, factoryCid = tf, receiver = w.bob, amount = 200.0, treasuryCids = [rest], executeBefore = addRelTime now (days 1)
  executeFails w.member pt
  execute w.gov pt
  s2 <- supply
  assertMsg ("supply still 1000 after the transfer offer, got " <> show s2) (s2 == 1000.0)
  is <- query @YapTransferInstruction w.gov
  assertMsg "one pending offer of 200 to bob" (length [ () | (_, i) <- is, i.transfer.receiver == w.bob, i.transfer.amount == 200.0 ] == 1)
  -- the governor cannot send to itself through this proposal, nor 0
  submitMustFail w.member do createCmd TreasuryTransferProposal with governanceParty = w.gov, proposer = w.member, factoryCid = tf, receiver = w.gov, amount = 1.0, treasuryCids = [rest], executeBefore = addRelTime now (days 1)
  submitMustFail w.member do createCmd TreasuryTransferProposal with governanceParty = w.gov, proposer = w.member, factoryCid = tf, receiver = w.bob, amount = 0.0, treasuryCids = [rest], executeBefore = addRelTime now (days 1)

-- helper: appoint through the governor-direct choice (the governed path is tested separately)
appoint : W -> Decimal -> Script (ContractId YapOperatorAuthority)
appoint w al = do
  now <- getTime
  submit w.gov do
    exerciseCmd w.adm YapAdmin_AppointOperator with operator = w.op, allowance = al, validUntil = addRelTime now (days 30)
